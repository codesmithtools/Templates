<%@ CodeTemplate Language="C#" TargetLanguage="TypeScript" Description="A TypeScript const object and type of a lookup table's rows, and their display names." %>
<%@ Property Name="SourceTable" Type="SchemaExplorer.TableSchema" Category="Source" Description="The lookup table." %>
<%@ Property Name="ValueColumn" Type="System.String" Optional="True" Category="Source" Description="The column the values come from. Empty: the primary key." %>
<%@ Property Name="NameColumn" Type="System.String" Optional="True" Category="Source" Description="The column the names and display names come from. Empty: the first text column that isn't the key." %>
<%@ Property Name="EnumName" Type="System.String" Optional="True" Category="Output" Description="The const's and type's name. Empty: the table's, singular, in Pascal case." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Assembly Src="Lookup.cs" %>
<%-- A const object and a type of the same name, rather than a TypeScript enum: plain values, nothing emitted for a type. --%>
<% var lookup = new Lookup(SourceTable, ValueColumn, NameColumn, EnumName); string name = lookup.EnumName; %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceTable.FullName %>.</auto-generated>
<% if (lookup.Members.Count == 0) { %>
// Warning: <%= SourceTable.FullName %> had no rows when this was generated: <%= name %> has no members. Generate it from the
// database with the rows.
<% } %>

/** The rows of <%= SourceTable.Name %>: <%= lookup.IsInteger ? "the values" : "the codes" %> (<%= lookup.ValueColumn.Name %>), by name. */
export const <%= name %> = {
<% foreach (LookupMember member in lookup.Members) { %>
  <%= member.Name %>: <%= lookup.Literal(member) %>,
<% } %>
} as const;

export type <%= name %> = (typeof <%= name %>)[keyof typeof <%= name %>];

/** The display names (<%= lookup.NameColumn.Name %>), by <%= lookup.IsInteger ? "value" : "code" %>. */
export const <%= char.ToLowerInvariant(name[0]) + name.Substring(1) %>Names: Readonly<Record<<%= name %>, string>> = {
<% foreach (LookupMember member in lookup.Members) { %>
  [<%= name %>.<%= member.Name %>]: <%= Lookup.Quote(member.Text) %>,
<% } %>
};
