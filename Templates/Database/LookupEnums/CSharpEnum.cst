<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A C# enum of a lookup table's rows, a [Description] on each; for a text key, ToCode and TryParseCode." %>
<%@ Property Name="SourceTable" Type="SchemaExplorer.TableSchema" Category="Source" Description="The lookup table." %>
<%@ Property Name="ValueColumn" Type="System.String" Optional="True" Category="Source" Description="The column the values come from. Empty: the primary key." %>
<%@ Property Name="NameColumn" Type="System.String" Optional="True" Category="Source" Description="The column the names and descriptions come from. Empty: the first text column that isn't the key." %>
<%@ Property Name="EnumName" Type="System.String" Optional="True" Category="Output" Description="The enum's name. Empty: the table's, singular, in Pascal case." %>
<%@ Property Name="TargetNamespace" Type="System.String" Default="MyApp.Data" Category="Output" Description="The enum's namespace." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Assembly Src="Lookup.cs" %>
<% var lookup = new Lookup(SourceTable, ValueColumn, NameColumn, EnumName); string name = lookup.EnumName; %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceTable.FullName %>.</auto-generated>
#nullable enable

using System;
using System.ComponentModel;

namespace <%= TargetNamespace %>;

/// <summary>The rows of <%= SourceTable.Name %>: <%= lookup.IsInteger ? "the values" : "the codes" %> are <%= lookup.ValueColumn.Name %>, the descriptions <%= lookup.NameColumn.Name %>.</summary>
public enum <%= name %><%= lookup.BaseType %>
{
<% foreach (LookupMember member in lookup.Members) { %>
    [Description(<%= Lookup.Quote(member.Text) %>)]
    <%= member.Name %><% if (lookup.IsInteger) { %> = <%= lookup.Literal(member) %><% } %>,
<% } %>
}
<% if (!lookup.IsInteger) { %>

/// <summary>The codes of <%= name %>, as <%= SourceTable.Name %>.<%= lookup.ValueColumn.Name %> has them.</summary>
public static class <%= name %>Extensions
{
    /// <summary>The value's code.</summary>
    public static string ToCode(this <%= name %> value) => value switch
    {
<% foreach (LookupMember member in lookup.Members) { %>
        <%= name %>.<%= member.Name %> => <%= lookup.Literal(member) %>,
<% } %>
        _ => throw new ArgumentOutOfRangeException(nameof(value), value, null),
    };

    /// <summary>The value with a code; false for a code that isn't one.</summary>
    public static bool TryParseCode(string? code, out <%= name %> value)
    {
        <%= name %>? found = code switch
        {
<% foreach (LookupMember member in lookup.Members) { %>
            <%= lookup.Literal(member) %> => <%= name %>.<%= member.Name %>,
<% } %>
            _ => null,
        };
        value = found.GetValueOrDefault();
        return found.HasValue;
    }
}
<% } %>
