<%@ CodeTemplate Language="C#" TargetLanguage="Text" Description="A table's page: its columns, a diagram of the tables it relates to, its keys both ways, its indexes, and the views and procedures that use it." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Docs.cs" %>
<%
var columns = Table.Columns.Cast<ColumnSchema>().ToList();
var foreignKeys = Table.ForeignKeys.Cast<TableKeySchema>().ToList();
var referencedBy = Docs.ReferencedBy(Table).ToList();
var indexes = Table.Indexes.Cast<IndexSchema>().OrderByDescending(i => i.IsPrimaryKey).ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase).ToList();
var usedBy = Docs.UsedBy(Table);
bool defaults = columns.Any(c => Docs.Default(c).Length > 0);
bool descriptions = columns.Any(c => Docs.Description(c).Length > 0);
bool references = foreignKeys.Count > 0;
string primaryKey = Table.HasPrimaryKey ? Docs.Code(string.Join(", ", Docs.PrimaryKeyColumns(Table))) : "none";
%>
<%= Docs.Breadcrumbs(Table) %>

# <%= Docs.Text(Docs.Title(Table)) %>
<% foreach (string paragraph in Docs.Paragraphs(Docs.Description(Table))) { %>

<%= paragraph %>
<% } %>

| Columns | Primary key | References | Referenced by | Indexes |
| :---: | :---: | :---: | :---: | :---: |
| <%= columns.Count %> | <%= primaryKey %> | <%= foreignKeys.Count %> | <%= referencedBy.Count %> | <%= indexes.Count %> |

## Columns

| # | Column | Type | Nullable | Key |<%= defaults ? " Default |" : "" %><%= references ? " References |" : "" %><%= descriptions ? " Description |" : "" %>
| ---: | --- | --- | :---: | --- |<%= defaults ? " --- |" : "" %><%= references ? " --- |" : "" %><%= descriptions ? " --- |" : "" %>
<% for (int i = 0; i < columns.Count; i++) { %>
<%
ColumnSchema column = columns[i];
var key = column.IsForeignKeyMember ? Docs.ForeignKeyOf(column) : null;
string reference = key == null ? "" : Docs.Link(key.PrimaryKeyTable, Table) + " (" + Docs.Code(Docs.ReferencedColumn(key, column.Name)) + ")";
%>
| <%= i + 1 %> | <%= Docs.Code(column.Name) %> | <%= Docs.Text(Docs.Type(column)) %> | <%= column.AllowDBNull ? "yes" : "no" %> | <%= Docs.KeyCell(column) %> |<%= defaults ? " " + Docs.Default(column) + " |" : "" %><%= references ? " " + reference + " |" : "" %><%= descriptions ? " " + Docs.Cell(Docs.Description(column)) + " |" : "" %>
<% } %>

## Relationships
<% if (foreignKeys.Count == 0 && referencedBy.Count == 0) { %>

No foreign key joins <%= Docs.Text(Docs.Title(Table)) %> to another table.
<% } else { %>

```mermaid
erDiagram
    direction LR
<% foreach (string line in Docs.Neighborhood(Table)) { %>
    <%= line %>
<% } %>
```

### References

<% if (foreignKeys.Count == 0) { %>
It refers to no other table.
<% } else { %>
| Foreign key | Columns | References | Kind |
| --- | --- | --- | --- |
<% foreach (TableKeySchema fk in foreignKeys) { %>
<% var members = fk.ForeignKeyMemberColumns.Cast<MemberColumnSchema>().ToList(); %>
| <%= Docs.Code(fk.Name) %> | <%= Docs.Code(string.Join(", ", members.Select(c => c.Name))) %> | <%= Docs.Link(fk.PrimaryKeyTable, Table) %> (<%= Docs.Code(string.Join(", ", members.Select(c => Docs.ReferencedColumn(fk, c.Name)))) %>) | <%= Docs.Cardinality(fk) %> |
<% } %>
<% } %>

### Referenced by

<% if (referencedBy.Count == 0) { %>
No other table refers to it.
<% } else { %>
| Table | Columns | Foreign key | Kind |
| --- | --- | --- | --- |
<% foreach (TableKeySchema fk in referencedBy) { %>
| <%= Docs.Link(fk.ForeignKeyTable, Table) %> | <%= Docs.Code(string.Join(", ", fk.ForeignKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => c.Name))) %> | <%= Docs.Code(fk.Name) %> | <%= Docs.Cardinality(fk).Replace("many to one", "one to many") %> |
<% } %>
<% } %>
<% } %>
<% if (indexes.Count > 0) { %>

## Indexes

| Index | Columns | Kind |
| --- | --- | --- |
<% foreach (IndexSchema index in indexes) { %>
| <%= Docs.Code(index.Name) %> | <%= Docs.Code(string.Join(", ", index.IsPrimaryKey && Table.HasPrimaryKey ? Docs.PrimaryKeyColumns(Table) : index.MemberColumns.Cast<MemberColumnSchema>().Select(c => c.Name))) %> | <%= index.IsPrimaryKey ? "primary key" : index.IsUnique ? "unique" : "index" %><%= index.IsClustered ? ", clustered" : "" %> |
<% } %>
<% } %>
<% if (usedBy.Count > 0) { %>

## Used by

The views and procedures whose SQL reads or writes it.

<% foreach (var item in usedBy) { %>
- <%= Docs.Link(item, Table) %> (<%= item is ViewSchema ? "view" : "procedure" %>)
<% } %>
<% } %>

---

<%= Docs.Pager(Table) %>
