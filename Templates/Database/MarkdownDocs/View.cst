<%@ CodeTemplate Language="C#" TargetLanguage="Text" Description="A view's page: its columns, the tables and views it uses, and its SQL." %>
<%@ Property Name="View" Type="SchemaExplorer.ViewSchema" Description="The view." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Docs.cs" %>
<%
var columns = View.Columns.Cast<ViewColumnSchema>().ToList();
var uses = Docs.Uses(View);
var usedBy = Docs.UsedBy(View);
string sql = Docs.Sql(View);
bool descriptions = columns.Any(c => Docs.Description(c).Length > 0);
%>
<%= Docs.Breadcrumbs(View) %>

# <%= Docs.Text(Docs.Title(View)) %>
<% foreach (string paragraph in Docs.Paragraphs(Docs.Description(View))) { %>

<%= paragraph %>
<% } %>

| Columns | Uses | Used by |
| :---: | :---: | :---: |
| <%= columns.Count %> | <%= uses.Count %> | <%= usedBy.Count %> |

## Columns

| # | Column | Type | Nullable |<%= descriptions ? " Description |" : "" %>
| ---: | --- | --- | :---: |<%= descriptions ? " --- |" : "" %>
<% for (int i = 0; i < columns.Count; i++) { %>
| <%= i + 1 %> | <%= Docs.Code(columns[i].Name) %> | <%= Docs.Text(Docs.Type(columns[i])) %> | <%= columns[i].AllowDBNull ? "yes" : "no" %> |<%= descriptions ? " " + Docs.Cell(Docs.Description(columns[i])) + " |" : "" %>
<% } %>
<% if (uses.Count > 0 || usedBy.Count > 0) { %>

## Related
<% if (uses.Count > 0) { %>

Uses <%= string.Join(", ", uses.Select(u => Docs.Link(u, View))) %>.
<% } %>
<% if (usedBy.Count > 0) { %>

Used by <%= string.Join(", ", usedBy.Select(u => Docs.Link(u, View))) %>.
<% } %>
<% } %>
<% if (sql.Length > 0) { %>

## Definition

<%= Docs.Fence(sql) %>sql
<%= sql %>
<%= Docs.Fence(sql) %>
<% } %>

---

<%= Docs.Pager(View) %>
<script runat="template">
// The page's file, as MarkdownDocs.cst names it (in its views folder).
public override string GetFileName() =>
    View == null ? base.GetFileName() : System.IO.Path.GetFileName(Docs.Page(View));
</script>
