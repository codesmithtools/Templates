<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="An EF Core entity for a table, as EF Core's scaffolding writes one: a partial class, nullable where the column is." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Data" %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="Tables left out (the master's Exclude): no navigation to them." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using System;
using System.Collections.Generic;

namespace <%= Namespace %>;

/// <summary>A row of <%= Table.Name %>.</summary>
public partial class <%= Names.Entity(Table) %>
{
<% foreach (ColumnSchema column in Table.Columns) { if (!Names.Mapped(column)) { %>
    // <%= Names.Property(column) %> (<%= column.NativeType %>): no .NET type, so EF Core can't map it; map it in a partial class of your own
<% continue; } %>
    public <%= Names.Required(column) %><%= Names.Type(column) %> <%= Names.Property(column) %> { get; set; }
<% } %>
<% foreach (TableKeySchema key in Table.ForeignKeys) { if (!Names.Related(key, Exclude)) continue; %>

    /// <summary>The <%= key.PrimaryKeyTable.Name %> it refers to (<%= key.Name %>).</summary>
<% if (key.ForeignKeyMemberColumns.Cast<MemberColumnSchema>().All(c => !c.AllowDBNull)) { %>
    public virtual <%= Names.Entity(key.PrimaryKeyTable) %> <%= Names.Navigation(key, Exclude) %> { get; set; } = null!;
<% } else { %>
    public virtual <%= Names.Entity(key.PrimaryKeyTable) %>? <%= Names.Navigation(key, Exclude) %> { get; set; }
<% } %>
<% } %>
<% foreach (TableKeySchema key in Names.ReferencesTo(Table, Exclude)) { %>

    /// <summary>The <%= key.ForeignKeyTable.Name %> rows that refer to it (<%= key.Name %>).</summary>
    public virtual ICollection<<%= Names.Entity(key.ForeignKeyTable) %>> <%= Names.Inverse(key, Exclude) %> { get; set; } = new List<<%= Names.Entity(key.ForeignKeyTable) %>>();
<% } %>
}
