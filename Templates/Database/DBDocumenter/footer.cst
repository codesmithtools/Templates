<%--
CodeSmith DBDocumenter Templates
Author:  Jason Alexander, Eric J. Smith
--%>
<%@ CodeTemplate Language="C#" TargetLanguage="HTML" Src="DBDocumenterTemplate.cs" Inherits="DBDocumenterTemplate" Description="The bottom of every page: its footer, the search dialog and the scripts." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Category="Context" Description="The database." %>
<%@ Property Name="ServerName" Type="System.String" Optional="True" Category="Output" Description="The server's name." %>
<%@ Property Name="DocumentationTitle" Type="System.String" Default="Database Documentation" Category="Output" Description="The documentation's title." %>
<%@ Property Name="RootPath" Type="System.String" Default="" Optional="True" Category="Page" Description="The output folder from the page's folder: empty or ../." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Assembly Name="System.Design" %>
<%@ Assembly Src="Site.cs" %>
<%@ Assembly Src="SqlHighlighter.cs" %>
<%@ Assembly Src="ErDiagram.cs" %>
<%@ Import Namespace="SchemaExplorer" %>
<script runat="template">
protected override string Root => RootPath ?? "";
</script>
<% DocSite site = Site; %>
</main>
<footer class="page-foot">
<span>Generated by <a href="https://www.codesmithtools.com/">CodeSmith Generator</a> from <%= H(SourceDatabase.Name) %> (<%= H(site.Product) %>)</span>
</footer>
</div>
</div>
<div class="palette" id="search" role="dialog" aria-modal="true" aria-label="Search" hidden>
<div class="palette-backdrop" data-search-close></div>
<div class="palette-panel">
<div class="palette-field">
<%= Icon("search") %>
<input class="palette-input" type="text" placeholder="Search tables, views, procedures and columns" aria-label="Search" aria-controls="search-results" aria-autocomplete="list" autocomplete="off" spellcheck="false">
<kbd class="kbd">Esc</kbd>
</div>
<div class="palette-results" id="search-results" role="listbox" aria-label="Results"></div>
<div class="palette-foot"><span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> to move</span><span><kbd class="kbd">↵</kbd> to open</span><span><kbd class="kbd">Esc</kbd> to close</span></div>
</div>
</div>
<script src="<%= Root %>assets/search-index.js"></script>
<script src="<%= Root %>assets/docs.js"></script>
</body>
</html>
