<%--
CodeSmith DBDocumenter Templates
Author:  Jason Alexander, Eric J. Smith
--%>
<%@ CodeTemplate Language="C#" TargetLanguage="HTML" Src="DBDocumenterTemplate.cs" Inherits="DBDocumenterTemplate" OutputType="None" Description="HTML documentation of a database: an overview with a relationship diagram, and a page for each table, view and procedure. Open index.html in the output folder." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Category="Context" Description="The database to document." DeepLoad="True" %>
<%@ Property Name="ServerName" Type="System.String" Optional="True" Category="Output" Description="The server's name, shown on the pages: the connection's server (or its file) where it's empty." %>
<%@ Property Name="DocumentationTitle" Type="System.String" Optional="True" Category="Output" Description="The documentation's title, on every page: the database's name where it's empty." %>
<%@ Register Name="OverviewTemplate" Template="overview.cst" MergeProperties="False" %>
<%@ Register Name="TableTemplate" Template="table.cst" MergeProperties="False" %>
<%@ Register Name="ViewTemplate" Template="view.cst" MergeProperties="False" %>
<%@ Register Name="ProcedureTemplate" Template="procedure.cst" MergeProperties="False" %>
<%@ Register Name="ServerTemplate" Template="server.cst" MergeProperties="False" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Assembly Name="System.Design" %>
<%@ Assembly Src="Site.cs" %>
<%@ Assembly Src="SqlHighlighter.cs" %>
<%@ Assembly Src="ErDiagram.cs" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.IO" %>
<%@ Import Namespace="System.Text" %>
<%@ Import Namespace="SchemaExplorer" %>
<%--
The master: it renders each page's template to its file in OutputDirectory, and copies the stylesheet and script
(assets/) beside them (WriteOutput). A page the last run wrote and this one doesn't is removed (RemoveOutput). The pages are index.html (overview.cst), tables/, views/ and procedures/ (table.cst, view.cst,
procedure.cst), and server.html for SQL Server (server.cst). Each page renders header.cst and footer.cst around it.
--%>
<script runat="template">
public override void Render(TextWriter writer)
{
    DateTime start = DateTime.Now;
    DocSite site = Site;
    string output = Path.GetFullPath(OutputDirectory);
    Progress.MaximumValue = site.Tables.Count + site.Views.Count + site.Commands.Count + 2;
    Progress.Step = 1;

    // the stylesheet and script, and the search's index of every object and column
    string assets = Path.Combine(output, "assets");
    foreach (string asset in new[] { "docs.css", "docs.js" })
        WriteOutput(Path.Combine(assets, asset), File.ReadAllText(Path.Combine(CodeTemplateInfo.DirectoryName, "assets", asset)));
    WriteOutput(Path.Combine(assets, "search-index.js"), site.SearchIndex());
    Progress.PerformStep();

    Page(Create<OverviewTemplate>(), Path.Combine(output, "index.html"));
    if (site.IsSqlServer)
        Page(Create<ServerTemplate>(), Path.Combine(output, "server.html"));
    foreach (TableSchema table in site.Tables)
    {
        var page = Create<TableTemplate>();
        page.SourceTable = table;
        Page(page, Path.Combine(output, site.File(table)));
    }
    foreach (ViewSchema view in site.Views)
    {
        var page = Create<ViewTemplate>();
        page.SourceView = view;
        Page(page, Path.Combine(output, site.File(view)));
    }
    foreach (CommandSchema command in site.Commands)
    {
        var page = Create<ProcedureTemplate>();
        page.SourceCommand = command;
        Page(page, Path.Combine(output, site.File(command)));
    }

    // the last run's pages that this one didn't write (a table that's been dropped), and nothing else of the folder's
    foreach (string folder in new[] { "", "tables", "views", "procedures" })
        RemoveStale(Path.Combine(output, folder));

    Trace.WriteLine("Documented " + SourceDatabase.Name + " in " + (DateTime.Now - start).TotalSeconds.ToString("0.0") + "s. Open " + Path.Combine(output, "index.html"));
}

private readonly HashSet<string> _written = new HashSet<string>(StringComparer.Ordinal);

// Renders a page to its file, with the master's properties (SourceDatabase, DocumentationTitle, ServerName...), and
// the database's name and server where they're empty.
private void Page(CodeTemplate page, string file)
{
    CopyPropertiesTo(page);
    page.SetProperty("DocumentationTitle", string.IsNullOrWhiteSpace(DocumentationTitle) ? SourceDatabase.Name : DocumentationTitle);
    page.SetProperty("ServerName", string.IsNullOrWhiteSpace(ServerName) ? Server() : ServerName);
    page.RenderToFile(file, true);
    _written.Add(Path.GetFullPath(file));
    Progress.PerformStep();
}

// The server the connection string names (Server, Host, Data Source; with its Port), or the file it opens (SQLite's
// database, SQL scripts, a schema snapshot): never more of it, as it may have a password.
private string Server()
{
    var builder = new System.Data.Common.DbConnectionStringBuilder();
    try
    {
        builder.ConnectionString = SourceDatabase.ConnectionString ?? "";
    }
    catch (ArgumentException)
    {
        return null;
    }
    foreach (string key in new[] { "Server", "Host", "Data Source", "DataSource", "Address", "Path", "File" })
    {
        if (!builder.TryGetValue(key, out object value) || !(value is string text) || text.Trim().Length == 0 || text.TrimStart().StartsWith("("))
            continue;
        text = text.Trim();
        if (text.IndexOfAny(new[] { '/', '\\' }) >= 0 || File.Exists(text))
            return Path.GetFileName(text.TrimEnd('/', '\\'));
        return builder.TryGetValue("Port", out object port) && port is string p && p.Length > 0 ? text + ":" + p : text;
    }
    return null;
}

// A page this run didn't write (RemoveOutput): cs generate removes it, and cs check says it's out of date.
private void RemoveStale(string folder)
{
    if (!Directory.Exists(folder))
        return;
    foreach (string file in Directory.GetFiles(folder, "*.html"))
        if (!_written.Contains(Path.GetFullPath(file)))
            RemoveOutput(file);
}
</script>
