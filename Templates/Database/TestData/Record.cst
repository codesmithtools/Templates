<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A C# record for a table's rows: a property for each column, nullable where the column is." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Data" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Assembly Src="Names.cs" %>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using System;

namespace <%= Namespace %>;

/// <summary>A row of <%= Table.Name %>.</summary>
public sealed record <%= Names.Entity(Table) %>
{
<% foreach (ColumnSchema column in Table.Columns) { %>
    public <%= Names.Required(column) %><%= column.GetCSharpTypeName() %> <%= Names.Property(column) %> { get; init; }
<% } %>
}
