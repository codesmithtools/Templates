<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's test data builder: Bogus rules for its columns' values, and rows saved after the rows they refer to." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Tests" %>
<%@ Property Name="DataNamespace" Type="System.String" Default="MyApp.Data" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Fakes.cs" %>
<%
    // the names, the keys and the rules the builder is made of
    string entity = Names.Entity(Table);
    string row = Names.Parameter(entity);
    var key = Names.Key(Table);
    ColumnSchema newKey = Names.GeneratedKey(Table);
    var parents = Fakes.Parents(Table);
    bool canInsert = Fakes.CanInsert(Table);
    string parameters = string.Concat(parents.Select(p => Names.Entity(p.Table) + "? " + p.Parameter + " = null, "));
    string arguments = string.Concat(parents.Select(p => p.Parameter + ", "));
    // each foreign key's columns from its parent's, once each
    var assigned = new HashSet<string>();
    var assignments = new List<string>();
    foreach (var parent in parents)
        foreach (var (column, referenced) in parent.Columns)
            if (assigned.Add(column.Name))
                assignments.Add(Names.Property(column) + " = " + Fakes.Value(column, referenced, parent.Parameter + (Optional(parent) ? "?" : "")));
%>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using System;
using System.Threading;
using System.Threading.Tasks;
using Bogus;
using <%= DataNamespace %>;

namespace <%= Namespace %>;

/// <summary>
/// Makes <%= Table.Name %> rows.
/// <see cref="Build"/> makes a row's values, and <see cref="CreateAsync"/> saves a row in the database. A partial class:
/// change it in a file of your own, with <c>Configure</c> (the rules) and <c>OnBuilt</c> (each row).
/// </summary>
public sealed partial class <%= Fakes.Builder(Table) %>
{
    private readonly TestData data;
    private readonly Randomizer random;

    internal <%= Fakes.Builder(Table) %>(TestData data)
    {
        this.data = data;
        random = new Randomizer(data.Seed);
        Faker = new Faker<<%= entity %>>()
            .UseSeed(data.Seed)<%= Rules() %>;
        Configure(Faker);
    }

    /// <summary>The rules for each column's value: one that fits the column, and a new one where it's a key's.</summary>
    public Faker<<%= entity %>> Faker { get; }

    /// <summary>Changes <see cref="Faker"/>'s rules (in a file of your own).</summary>
    partial void Configure(Faker<<%= entity %>> faker);

    /// <summary>Changes each row <see cref="Build"/> makes (in a file of your own).</summary>
    partial void OnBuilt(ref <%= entity %> <%= row %>);

<% if (parents.Count == 0) { %>
    /// <summary>A row's values, not saved: each fits its column, and a key's or a unique column's is new.</summary>
<% } else { %>
    /// <summary>
    /// A row's values, not saved: each fits its column, and a key's or a unique column's is new. Its foreign keys are
    /// made up: <see cref="BuildAsync"/> and <see cref="CreateAsync"/> give them the rows they refer to.
    /// </summary>
<% } %>
    public <%= entity %> Build()
    {
        var <%= row %> = Faker.Generate();
        OnBuilt(ref <%= row %>);
        return <%= row %>;
    }
<% if (parents.Count == 0) { %>

    /// <summary>A row's values, not saved (as <see cref="Build"/> makes them); <paramref name="change"/> changes them.</summary>
    public Task<<%= entity %>> BuildAsync(Func<<%= entity %>, <%= entity %>>? change = null, CancellationToken cancellationToken = default)
    {
        var <%= row %> = Build();
        return Task.FromResult(change is null ? <%= row %> : change(<%= row %>));
    }
<% } else { %>

    /// <summary>A row's values, not saved, with the rows its foreign keys refer to. <paramref name="change"/> changes the
    /// row last.</summary>
<% foreach (var parent in parents) { %>
    /// <param name="<%= parent.Parameter %>">The <%= parent.Table.Name %> row it refers to; null: <%= Made(parent) %>.</param>
<% } %>
    public async Task<<%= entity %>> BuildAsync(<%= parameters %>Func<<%= entity %>, <%= entity %>>? change = null, CancellationToken cancellationToken = default)
    {
<% foreach (var parent in parents) { %>
        <%= parent.Parameter %> ??= <%= Find(parent) %>;
<% } %>
        var <%= row %> = Build() with
        {
<% foreach (string assignment in assignments) { %>
            <%= assignment %>,
<% } %>
        };
        return change is null ? <%= row %> : change(<%= row %>);
    }
<% } %>
<% if (canInsert) { %>

<% if (parents.Count == 0) { %>
    /// <summary>A row saved in the database, as <see cref="BuildAsync"/> makes it. It's returned as the database has
    /// it<%= newKey != null ? ", with the " + Names.Property(newKey) + " the database gave it" : "" %>.</summary>
<% } else { %>
    /// <summary>A row saved in the database, after the rows it refers to, as <see cref="BuildAsync"/> makes it. It's
    /// returned as the database has it<%= newKey != null ? ", with the " + Names.Property(newKey) + " the database gave it" : "" %>.</summary>
<% } %>
    public async Task<<%= entity %>> CreateAsync(<%= parameters %>Func<<%= entity %>, <%= entity %>>? change = null, CancellationToken cancellationToken = default)
    {
        var <%= row %> = await BuildAsync(<%= arguments %>change, cancellationToken);
        var repository = new <%= Names.Repository(Table) %>(data.Connection);
<% if (newKey != null) { %>
        var <%= Names.Parameter(Names.Property(newKey)) %> = await repository.InsertAsync(<%= row %>, cancellationToken);
        return await repository.GetAsync(<%= Names.Parameter(Names.Property(newKey)) %>, cancellationToken)
            ?? throw new InvalidOperationException("The <%= Table.Name %> row just saved isn't there.");
<% } else { %>
        await repository.InsertAsync(<%= row %>, cancellationToken);
        return await repository.GetAsync(<%= string.Join(", ", key.Select(c => row + "." + Names.Property(c))) %>, cancellationToken)
            ?? throw new InvalidOperationException("The <%= Table.Name %> row just saved isn't there.");
<% } %>
    }
<% } %>

    /// <summary>One of the rows that are there, picked by the seed; null where there are none.</summary>
    public async Task<<%= entity %>?> ExistingAsync(CancellationToken cancellationToken = default)
    {
        var rows = await new <%= Names.Repository(Table) %>(data.Connection).GetAllAsync(cancellationToken);
        return rows.Count == 0 ? null : rows[random.Int(0, rows.Count - 1)];
    }
<% if (canInsert) { %>

    // A row for another table's foreign key: a new one, or with ReuseParents one that's there.
    internal async Task<<%= entity %>> ParentAsync(CancellationToken cancellationToken) =>
        (data.ReuseParents ? await ExistingAsync(cancellationToken) : null) ?? await CreateAsync(cancellationToken: cancellationToken);
<% } %>
}
<script runat="template">
// A parent that's never made here, only taken (one that leads back to this table, or one the repository can't add):
// a row that's there, or none where the foreign key can be null.
private static bool Taken(Fakes.Parent parent) => parent.Cyclic || !Fakes.CanInsert(parent.Table);

private static bool Optional(Fakes.Parent parent) => Taken(parent) && parent.Nullable;

// How a parent that isn't given is found.
private string Find(Fakes.Parent parent)
{
    string builder = "data." + Fakes.Builders(parent.Table);
    if (Taken(parent))
        return "await " + builder + ".ExistingAsync(cancellationToken)" + (parent.Nullable ? "" :
            Environment.NewLine + "            ?? throw new InvalidOperationException(\"" + Table.Name + "'s " +
            string.Join(", ", parent.Columns.Select(c => c.Column.Name)) + " refers to " + parent.Table.Name +
            ", which has no rows to take: give " + parent.Parameter + ".\")");
    return parent.OnePerParent
        ? "await " + builder + ".CreateAsync(cancellationToken: cancellationToken)"
        : "await " + builder + ".ParentAsync(cancellationToken)";
}

// The rules, a line each: .RuleFor(o => o.OrderDate, f => ...), or what's missing.
private string Rules()
{
    string x = Fakes.Lambda(Table);
    var lines = new System.Text.StringBuilder();
    foreach (ColumnSchema column in Table.Columns.Cast<ColumnSchema>().Where(Names.Written))
    {
        string rule = Fakes.Rule(column);
        lines.Append(Environment.NewLine).Append(' ', 12).Append(rule == null
            ? "// " + Names.Property(column) + ": no rule for " + column.NativeType + " (" + column.GetCSharpTypeName() + "); Configure can give one"
            : ".RuleFor(" + x + " => " + x + "." + Names.Property(column) + ", f => " + rule + ")");
    }
    return lines.ToString();
}

// What BuildAsync's documentation says of a parent it finds.
private static string Made(Fakes.Parent parent) =>
    Taken(parent) ? "one that's there" + (parent.Nullable ? ", or none" : "") :
    parent.OnePerParent ? "a new one" :
    "a new one, or with ReuseParents one that's there";
</script>
