<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="Test data builders (Bogus) and xUnit tests for each table's Dapper repository: TestData, a builder per table, and each repository's tests." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Category="Source" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Tests" Category="Output" Description="The namespace of the builders and tests." %>
<%@ Property Name="DataNamespace" Type="System.String" Default="MyApp.Data" Category="Output" Description="The records' and repositories' namespace (Repositories.cst's Namespace)." %>
<%@ Property Name="TestBase" Type="System.String" Default="DatabaseTest" Category="Output" Description="The class the tests derive from (yours): it gives each test its Connection, Data and CancellationToken." %>
<%@ Property Name="OutputDirectory" Type="System.String" Default="Generated" Category="Output" Description="Where Builders/ and Tests/ go, relative to the project." %>
<%@ Register Name="BuilderTemplate" Template="Builder.cst" MergeProperties="False" %>
<%@ Register Name="TestsTemplate" Template="RepositoryTests.cst" MergeProperties="False" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.IO" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Fakes.cs" %>
<%-- The master: a builder (Builder.cst) and the repository's tests (RepositoryTests.cst) for each table, a file each, and
     itself TestData, which has every builder. --%>
<% Generate(); %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
#nullable enable

using System;
using System.Data.Common;
using Bogus;

namespace <%= Namespace %>;

/// <summary>
/// A test data builder for each table, on one connection: rows the database takes, with values that fit each column,
/// keys of their own, and the rows their foreign keys refer to, saved first. A partial class: add to it in a file of
/// your own.
/// </summary>
public sealed partial class TestData
{
    /// <summary>Builders that save rows on <paramref name="connection"/>. The same <paramref name="seed"/> makes the same
    /// rows.</summary>
    public TestData(DbConnection connection, int seed = 1)
    {
        Connection = connection;
        Seed = seed;
<% foreach (TableSchema table in SourceDatabase.Tables) { %>
        <%= Fakes.Builders(table) %> = new <%= Fakes.Builder(table) %>(this);
<% } %>
    }

    /// <summary>The connection the builders save rows on.</summary>
    public DbConnection Connection { get; }

    /// <summary>The seed of every builder's rules and picks.</summary>
    public int Seed { get; }

    /// <summary>The day the builders' dates are before: today, unless you set it.</summary>
    public DateTime Today { get; init; } = DateTime.Today;

    /// <summary>true: a foreign key refers to one of the rows its table has, where it has any, instead of a new one.</summary>
    public bool ReuseParents { get; set; }
<% foreach (TableSchema table in SourceDatabase.Tables) { %>

    /// <summary><%= table.Name %> rows.</summary>
    public <%= Fakes.Builder(table) %> <%= Fakes.Builders(table) %> { get; }
<% } %>
}

/// <summary>What the builders' rules share.</summary>
internal static class Fake
{
    private const string Characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

    /// <summary>The text, cut to the column's length.</summary>
    public static string Fit(string text, int length) => text.Length <= length ? text : text[..length];

    /// <summary>Letters and digits, a code (K3J9X2M1Q8): a new one each time.</summary>
    public static string Code(Faker f, int length) => f.Random.String2(length, Characters);

    /// <summary>The text after a random part, so that it's new each time (k3j9x2.jane_doe), cut to the column's length
    /// (0: none).</summary>
    public static string Unique(Faker f, string text, int length)
    {
        if (length > 0 && length <= 12)
            return Code(f, Math.Min(length, 10));
        string unique = Code(f, 6).ToLowerInvariant() + ".";
        return length > 0 ? Fit(unique + text, length) : unique + text;
    }

    /// <summary>A date and time to the second, of no time zone, as databases keep them.</summary>
    public static DateTime Moment(DateTime value) =>
        new(value.Ticks - value.Ticks % TimeSpan.TicksPerSecond, DateTimeKind.Unspecified);
}
<script runat="template">
// A builder and the repository's tests for each table; then the files of tables that are gone go.
private void Generate()
{
    string builders = Path.Combine(OutputDirectory, "Builders");
    string tests = Path.Combine(OutputDirectory, "Tests");
    Directory.CreateDirectory(builders);
    Directory.CreateDirectory(tests);
    var written = new HashSet<string>(StringComparer.Ordinal);
    foreach (TableSchema table in SourceDatabase.Tables)
    {
        var builder = Create<BuilderTemplate>();
        builder.Table = table;
        builder.Namespace = Namespace;
        builder.DataNamespace = DataNamespace;
        string file = Path.Combine(builders, Fakes.Builder(table) + ".cs");
        builder.RenderToFile(file, true);
        written.Add(Path.GetFullPath(file));

        var test = Create<TestsTemplate>();
        test.Table = table;
        test.Namespace = Namespace;
        test.DataNamespace = DataNamespace;
        test.TestBase = TestBase;
        file = Path.Combine(tests, Fakes.Tests(table) + ".cs");
        test.RenderToFile(file, true);
        written.Add(Path.GetFullPath(file));
    }
    RemoveStale(builders, written);
    RemoveStale(tests, written);
}

// A generated file this run didn't write: its table is gone. Raised as an output without content first: cs check counts
// it as a change (and cancels), cs generate removes it.
private void RemoveStale(string directory, HashSet<string> written)
{
    foreach (string file in Directory.GetFiles(directory, "*.cs"))
    {
        string path = Path.GetFullPath(file);
        if (written.Contains(path))
            continue;
        var output = new OutputCancelEventArgs(new OutputFile(path));
        OnPreOutputWritten(output);
        if (!output.Cancel)
            File.Delete(path);
    }
}
</script>
