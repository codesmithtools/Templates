<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="An async Dapper repository for a table: get all, get by key, insert, update and delete, in the database's SQL." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Data" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%
    // the names, the key and the columns the methods and their SQL are made of
    string entity = Names.Entity(Table);
    string record = Names.Parameter(entity);
    string table = Names.Table(Table);
    var key = Names.Key(Table);
    ColumnSchema newKey = Names.GeneratedKey(Table);
    var inserted = Table.Columns.Cast<ColumnSchema>().Where(Names.Written).ToList();
    var updated = inserted.Where(c => !c.IsPrimaryKeyMember).ToList();
    var selected = Table.Columns.Cast<ColumnSchema>().Select(Names.Selected).ToList();
    string keyParameters = string.Join(", ", key.Select(c => c.GetCSharpTypeName() + " " + Names.Parameter(Names.Property(c))));
    string keyValues = "new { " + string.Join(", ", key.Select(c => Names.Property(c) + " = " + Names.Parameter(Names.Property(c)))) + " }";
    string where = string.Join(" AND ", key.Select(Names.Assignment));
%>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using System;
using System.Collections.Generic;
using System.Data.Common;
using System.Threading;
using System.Threading.Tasks;
using Dapper;

namespace <%= Namespace %>;

/// <summary>Reads and writes <%= Table.Name %> rows with Dapper, on the connection it's given.</summary>
public sealed partial class <%= Names.Repository(Table) %>(DbConnection connection)
{
    /// <summary>Every row.</summary>
    public async Task<IReadOnlyList<<%= entity %>>> GetAllAsync(CancellationToken cancellationToken = default)
    {
        const string sql = """
            <%= Names.Clause("SELECT ", selected) %>
            FROM <%= table %>
            """;
        return (await connection.QueryAsync<<%= entity %>>(new CommandDefinition(sql, cancellationToken: cancellationToken))).AsList();
    }
<% if (key.Count > 0) { %>

    /// <summary>The row with this key, or null.</summary>
    public Task<<%= entity %>?> GetAsync(<%= keyParameters %>, CancellationToken cancellationToken = default)
    {
        const string sql = """
            <%= Names.Clause("SELECT ", selected) %>
            FROM <%= table %>
            WHERE <%= where %>
            """;
        return connection.QuerySingleOrDefaultAsync<<%= entity %>>(new CommandDefinition(sql, <%= keyValues %>, cancellationToken: cancellationToken));
    }
<% if (inserted.Count > 0 && newKey != null) { %>

    /// <summary>Adds a row, and returns the <%= Names.Property(newKey) %> the database gave it.</summary>
    public Task<<%= newKey.GetCSharpTypeName() %>> InsertAsync(<%= entity %> <%= record %>, CancellationToken cancellationToken = default)
    {
        const string sql = """
            <%= Names.Clause("INSERT INTO " + table + " (", inserted.Select(Names.Column), ")") %>
            <%= Names.Clause("VALUES (", inserted.Select(c => "@" + Names.Property(c)), ")") %><%= Names.NewKey(newKey) %>
            """;
        return connection.ExecuteScalarAsync<<%= newKey.GetCSharpTypeName() %>>(new CommandDefinition(sql, <%= record %>, cancellationToken: cancellationToken));
    }
<% } else if (inserted.Count > 0) { %>

    /// <summary>Adds a row.</summary>
    public Task InsertAsync(<%= entity %> <%= record %>, CancellationToken cancellationToken = default)
    {
        const string sql = """
            <%= Names.Clause("INSERT INTO " + table + " (", inserted.Select(Names.Column), ")") %>
            <%= Names.Clause("VALUES (", inserted.Select(c => "@" + Names.Property(c)), ")") %>
            """;
        return connection.ExecuteAsync(new CommandDefinition(sql, <%= record %>, cancellationToken: cancellationToken));
    }
<% } %>
<% if (updated.Count > 0) { %>

    /// <summary>Saves the record to the row with its key; false if there's no such row.</summary>
    public async Task<bool> UpdateAsync(<%= entity %> <%= record %>, CancellationToken cancellationToken = default)
    {
        const string sql = """
            UPDATE <%= table %>
            <%= Names.Clause("SET ", updated.Select(Names.Assignment)) %>
            WHERE <%= where %>
            """;
        return await connection.ExecuteAsync(new CommandDefinition(sql, <%= record %>, cancellationToken: cancellationToken)) > 0;
    }
<% } %>

    /// <summary>Deletes the row with this key; false if there's no such row.</summary>
    public async Task<bool> DeleteAsync(<%= keyParameters %>, CancellationToken cancellationToken = default)
    {
        const string sql = """
            DELETE FROM <%= table %>
            WHERE <%= where %>
            """;
        return await connection.ExecuteAsync(new CommandDefinition(sql, <%= keyValues %>, cancellationToken: cancellationToken)) > 0;
    }
<% } %>
}
