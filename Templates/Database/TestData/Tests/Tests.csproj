<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are programs, run by Microsoft.Testing.Platform (global.json) -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PetShop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- what cs generate writes: the records and repositories (Generated/Data), TestData, the builders and the tests -->
    <Compile Include="../Generated/**/*.cs" />
    <!-- the database each test copies -->
    <None Include="../PetShop.db3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
