<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's repository tests (xUnit): insert and get by key, update, delete, and list, each with a row of its own." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Tests" %>
<%@ Property Name="DataNamespace" Type="System.String" Default="MyApp.Data" %>
<%@ Property Name="TestBase" Type="System.String" Default="DatabaseTest" Description="The class the tests derive from (yours): Connection, Data and CancellationToken." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Fakes.cs" %>
<%
    // the names and keys the tests are made of
    string entity = Names.Entity(Table);
    string row = Names.Parameter(entity);
    string repository = Names.Repository(Table);
    string builder = "Data." + Fakes.Builders(Table);
    var key = Names.Key(Table);
    ColumnSchema newKey = Names.GeneratedKey(Table);
    string keyOf = string.Join(", ", key.Select(c => row + "." + Names.Property(c)));
    string matches = string.Join(" && ", key.Select(c => "r." + Names.Property(c) + " == " + row + "." + Names.Property(c)));
    // what an update keeps: the key, and the foreign keys (their rows are there)
    var kept = key.Concat(Fakes.Parents(Table).SelectMany(p => p.Columns.Select(c => c.Column)).Where(Names.Written))
        .Select(Names.Property).Distinct().ToList();
%>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using System.Threading.Tasks;
using <%= DataNamespace %>;
using Xunit;

namespace <%= Namespace %>;

<% if (!Fakes.CanInsert(Table)) { %>
/// <summary><see cref="<%= repository %>"/> against the database. <%= Table.Name %> has <%= key.Count == 0 ? "no primary key" : "no column to write" %>, so its
/// repository only reads. A partial class: add tests in a file of your own.</summary>
public sealed partial class <%= Fakes.Tests(Table) %> : <%= TestBase %>
{
    [Fact]
    public async Task GetAllAsyncReadsTheTable()
    {
        var rows = await new <%= repository %>(Connection).GetAllAsync(CancellationToken);

        Assert.NotNull(rows);
    }
}
<% } else { %>
/// <summary><see cref="<%= repository %>"/> against the database, each test with a row of its own that
/// <see cref="<%= Fakes.Builder(Table) %>"/> makes. A partial class: add tests in a file of your own.</summary>
public sealed partial class <%= Fakes.Tests(Table) %> : <%= TestBase %>
{
    [Fact]
    public async Task InsertAsyncAddsARowThatGetAsyncReads()
    {
        var repository = new <%= repository %>(Connection);
        var <%= row %> = await <%= builder %>.BuildAsync(cancellationToken: CancellationToken);

<% if (newKey != null) { %>
        var <%= Names.Parameter(Names.Property(newKey)) %> = await repository.InsertAsync(<%= row %>, CancellationToken);

        AssertSaved(<%= row %>, await repository.GetAsync(<%= Names.Parameter(Names.Property(newKey)) %>, CancellationToken));
<% } else { %>
        await repository.InsertAsync(<%= row %>, CancellationToken);

        AssertSaved(<%= row %>, await repository.GetAsync(<%= keyOf %>, CancellationToken));
<% } %>
    }
<% if (Fakes.CanUpdate(Table)) { %>

    [Fact]
    public async Task UpdateAsyncChangesTheRow()
    {
        var repository = new <%= repository %>(Connection);
        var <%= row %> = await <%= builder %>.CreateAsync(cancellationToken: CancellationToken);
        var changed = <%= builder %>.Build() with { <%= string.Join(", ", kept.Select(p => p + " = " + row + "." + p)) %> };

        Assert.True(await repository.UpdateAsync(changed, CancellationToken));

        AssertSaved(changed, await repository.GetAsync(<%= keyOf %>, CancellationToken));
    }
<% } %>

    [Fact]
    public async Task DeleteAsyncRemovesTheRow()
    {
        var repository = new <%= repository %>(Connection);
        var <%= row %> = await <%= builder %>.CreateAsync(cancellationToken: CancellationToken);

        Assert.True(await repository.DeleteAsync(<%= keyOf %>, CancellationToken));

        Assert.Null(await repository.GetAsync(<%= keyOf %>, CancellationToken));
        Assert.False(await repository.DeleteAsync(<%= keyOf %>, CancellationToken));
<% if (Fakes.CanUpdate(Table)) { %>
        Assert.False(await repository.UpdateAsync(<%= row %>, CancellationToken));
<% } %>
    }

    [Fact]
    public async Task GetAllAsyncListsEveryRow()
    {
        var repository = new <%= repository %>(Connection);
        int before = (await repository.GetAllAsync(CancellationToken)).Count;
        var <%= row %> = await <%= builder %>.CreateAsync(cancellationToken: CancellationToken);

        var rows = await repository.GetAllAsync(CancellationToken);

        Assert.Equal(before + 1, rows.Count);
        Assert.Contains(rows, r => <%= matches %>);
    }

    // what InsertAsync and UpdateAsync write, as they wrote it
    private static void AssertSaved(<%= entity %> expected, <%= entity %>? saved)
    {
        Assert.NotNull(saved);
<% foreach (ColumnSchema column in Fakes.Written(Table)) { %>
        Assert.Equal(expected.<%= Names.Property(column) %>, saved.<%= Names.Property(column) %>);
<% } %>
    }
}
<% } %>
