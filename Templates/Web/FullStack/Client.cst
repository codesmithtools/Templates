<%@ CodeTemplate Language="C#" TargetLanguage="TypeScript" Description="A TypeScript client for the API (Api.cst): a Zod schema and a type for each table's rows and requests, and a typed fetch call for each endpoint." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Category="Source" Description="The database." %>
<%@ Property Name="ApiName" Type="System.String" Default="App" Category="Output" Description="Names the client: create{ApiName}Client." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Web.cs" %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
import { z } from "zod";
<% foreach (TableSchema table in SourceDatabase.Tables) { string entity = Names.Entity(table); %>

/** A row of <%= table.Name %>. */
export const <%= entity %>Schema = z.object({
<% foreach (ColumnSchema column in table.Columns) { %>
  <%= Web.Json(column) %>: <%= Web.Zod(column, false) %>,
<% } %>
});
export type <%= entity %> = z.infer<typeof <%= entity %>Schema>;
<% if (Web.Key(table).Count > 0) { %>

/** A new row of <%= table.Name %>. */
export const Create<%= entity %>RequestSchema = z.object({
<% foreach (ColumnSchema column in Web.Creates(table)) { %>
  <%= Web.Json(column) %>: <%= Web.Zod(column, true) %>,
<% } %>
});
export type Create<%= entity %>Request = z.infer<typeof Create<%= entity %>RequestSchema>;

/** Changes to a row of <%= table.Name %>: everything but its key. */
export const Update<%= entity %>RequestSchema = z.object({
<% foreach (ColumnSchema column in Web.Updates(table)) { %>
  <%= Web.Json(column) %>: <%= Web.Zod(column, true) %>,
<% } %>
});
export type Update<%= entity %>Request = z.infer<typeof Update<%= entity %>RequestSchema>;
<% } %>
<% } %>

/** A response that wasn't a success. */
export class ApiError extends Error {
  readonly status: number;
  readonly body: string;

  constructor(status: number, body: string) {
    super(`The API answered ${status}: ${body}`);
    this.status = status;
    this.body = body;
  }
}

export interface <%= ApiName %>ClientOptions {
  /** Where the API is: "http://localhost:5000". */
  baseUrl: string;
  fetch?: typeof fetch;
}

/** The API's endpoints, checked against their schemas both ways. */
export function create<%= ApiName %>Client(options: <%= ApiName %>ClientOptions) {
  const call = async (method: string, path: string, body?: unknown): Promise<unknown> => {
    const response = await (options.fetch ?? fetch)(options.baseUrl + path, {
      method,
      headers: body === undefined ? undefined : { "Content-Type": "application/json" },
      body: body === undefined ? undefined : JSON.stringify(body),
    });
    if (!response.ok) throw new ApiError(response.status, await response.text());
    return response.status === 204 ? undefined : response.json();
  };
  const found = async (path: string): Promise<unknown> => {
    try {
      return await call("GET", path);
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) return undefined;
      throw error;
    }
  };
  return {
<% foreach (TableSchema table in SourceDatabase.Tables) {
       string entity = Names.Entity(table);
       string route = Web.Route(table);
       var key = Web.Key(table);
       string keyParameters = string.Join(", ", key.Select(c => Web.Parameter(c) + ": " + Web.TypeScript(c)));
       string keyPath = route + string.Concat(key.Select(c => "/${encodeURIComponent(" + Web.Parameter(c) + ")}")); %>
    <%= char.ToLowerInvariant(Names.Set(table)[0]) + Names.Set(table).Substring(1) %>: {
      list: async (page = 1, pageSize = 50): Promise<<%= entity %>[]> =>
        z.array(<%= entity %>Schema).parse(await call("GET", `<%= route %>?page=${page}&pageSize=${pageSize}`)),
<% if (key.Count > 0) { %>
      get: async (<%= keyParameters %>): Promise<<%= entity %> | undefined> => {
        const row = await found(`<%= keyPath %>`);
        return row === undefined ? undefined : <%= entity %>Schema.parse(row);
      },
      create: async (request: Create<%= entity %>Request): Promise<<%= entity %>> =>
        <%= entity %>Schema.parse(await call("POST", "<%= route %>", Create<%= entity %>RequestSchema.parse(request))),
      update: async (<%= keyParameters %>, request: Update<%= entity %>Request): Promise<void> => {
        await call("PUT", `<%= keyPath %>`, Update<%= entity %>RequestSchema.parse(request));
      },
      delete: async (<%= keyParameters %>): Promise<void> => {
        await call("DELETE", `<%= keyPath %>`);
      },
<% } %>
    },
<% } %>
  };
}
