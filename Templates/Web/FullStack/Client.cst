<%@ CodeTemplate Language="C#" TargetLanguage="TypeScript" Description="A TypeScript client for the API (Api.cst): a Zod schema and a type for each table's rows and requests, and a typed fetch call for each endpoint." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Category="Source" Description="The database." %>
<%@ Property Name="ApiName" Type="System.String" Default="App" Category="Output" Description="Names the client: create{ApiName}Client." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Web.cs" %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
import { z } from "zod";

/** A page of rows, and how many there are in all. */
export interface Paged<T> {
  items: T[];
  total: number;
  page: number;
  pageSize: number;
}

const paged = <T extends z.ZodType>(row: T) =>
  z.object({ items: z.array(row), total: z.number(), page: z.number(), pageSize: z.number() });

/** What a list asks for: a page (from 1; 50 rows), the column it's sorted by, text to search for, and filters (rows
 * whose column is one of the values). */
export interface ListOptions<TSort extends string = string, TFilter = Record<string, readonly unknown[] | undefined>> {
  page?: number;
  pageSize?: number;
  sort?: TSort;
  desc?: boolean;
  search?: string;
  filter?: TFilter;
}

/** How many rows a table has (the table as its endpoints name it: line-items). */
export const RowCountSchema = z.object({ table: z.string(), rows: z.number() });
export type RowCount = z.infer<typeof RowCountSchema>;
<% foreach (TableSchema table in SourceDatabase.Tables) { string entity = Names.Entity(table); var sorts = Web.Sorts(table); var filters = Web.Filters(table); %>

/** A row of <%= table.Name %>. */
export const <%= entity %>Schema = z.object({
<% foreach (ColumnSchema column in table.Columns) { %>
  <%= Web.Json(column) %>: <%= Web.Zod(column, false) %>,
<% } %>
});
export type <%= entity %> = z.infer<typeof <%= entity %>Schema>;

/** The columns a list of <%= table.Name %> sorts by, and its filters. */
export type <%= entity %>Sort = <%= sorts.Count == 0 ? "never" : string.Join(" | ", sorts.Select(c => "\"" + Web.Json(c) + "\"")) %>;
export type <%= entity %>Filter = {<%= filters.Count == 0 ? "" : " " + string.Join("; ", filters.Select(c => Web.Filter(c) + "?: readonly " + Web.TypeScript(c) + "[]")) + " " %>};
export type <%= entity %>ListOptions = ListOptions<<%= entity %>Sort, <%= entity %>Filter>;
<% if (Web.Key(table).Count > 0) { %>

/** A new row of <%= table.Name %>. */
export const Create<%= entity %>RequestSchema = z.object({
<% foreach (ColumnSchema column in Web.Creates(table)) { %>
  <%= Web.Json(column) %>: <%= Web.Zod(column, true) %>,
<% } %>
});
export type Create<%= entity %>Request = z.infer<typeof Create<%= entity %>RequestSchema>;

/** Changes to a row of <%= table.Name %>: everything but its key. */
export const Update<%= entity %>RequestSchema = z.object({
<% foreach (ColumnSchema column in Web.Updates(table)) { %>
  <%= Web.Json(column) %>: <%= Web.Zod(column, true) %>,
<% } %>
});
export type Update<%= entity %>Request = z.infer<typeof Update<%= entity %>RequestSchema>;
<% } %>
<% } %>

/** A problem the API describes (RFC 9457): what went wrong, and for a request that isn't valid, what's wrong with
 * each of its fields. A save the database refused (409) says why (refusal: unique, reference, referenced or other), and
 * in Development the database's own message. */
export const ProblemSchema = z.object({
  type: z.string().optional(),
  title: z.string().optional(),
  status: z.number().optional(),
  detail: z.string().optional(),
  errors: z.record(z.string(), z.array(z.string())).optional(),
  refusal: z.string().optional(),
  database: z.string().optional(),
});
export type Problem = z.infer<typeof ProblemSchema>;

/** A response that wasn't a success, and the problem it describes (where it's one). */
export class ApiError extends Error {
  readonly status: number;
  readonly body: string;
  readonly problem: Problem | undefined;

  constructor(status: number, body: string) {
    let problem: Problem | undefined;
    try {
      const parsed = ProblemSchema.safeParse(JSON.parse(body));
      problem = parsed.success ? parsed.data : undefined;
    } catch {
      problem = undefined;
    }
    super(`The API answered ${status}: ${problem?.detail ?? problem?.title ?? body}`);
    this.status = status;
    this.body = body;
    this.problem = problem;
  }
}

export interface <%= ApiName %>ClientOptions {
  /** Where the API is: "http://localhost:5000" ("" for the page's own). */
  baseUrl: string;
  fetch?: typeof fetch;
}

// a list's query string: ?page=2&sort=name&desc=true&categoryId=BIRDS&categoryId=FISH
const query = (options: ListOptions<string, object>): string => {
  const parameters = new URLSearchParams();
  if (options.page !== undefined) parameters.set("page", String(options.page));
  if (options.pageSize !== undefined) parameters.set("pageSize", String(options.pageSize));
  if (options.sort) parameters.set("sort", options.sort);
  if (options.desc) parameters.set("desc", "true");
  if (options.search) parameters.set("search", options.search);
  for (const [name, values] of Object.entries(options.filter ?? {}))
    for (const value of (values ?? []) as readonly unknown[]) parameters.append(name, String(value));
  const text = parameters.toString();
  return text ? "?" + text : "";
};

/** The API's endpoints, checked against their schemas both ways. */
export function create<%= ApiName %>Client(options: <%= ApiName %>ClientOptions) {
  const call = async (method: string, path: string, body?: unknown): Promise<unknown> => {
    const response = await (options.fetch ?? fetch)(options.baseUrl + path, {
      method,
      headers: body === undefined ? undefined : { "Content-Type": "application/json" },
      body: body === undefined ? undefined : JSON.stringify(body),
    });
    if (!response.ok) throw new ApiError(response.status, await response.text());
    return response.status === 204 ? undefined : response.json();
  };
  const found = async (path: string): Promise<unknown> => {
    try {
      return await call("GET", path);
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) return undefined;
      throw error;
    }
  };
  return {
    /** How many rows each table has. */
    rowCounts: async (): Promise<RowCount[]> => z.array(RowCountSchema).parse(await call("GET", "/api")),
<% foreach (TableSchema table in SourceDatabase.Tables) {
       string entity = Names.Entity(table);
       string route = Web.Route(table);
       var key = Web.Key(table);
       string keyParameters = string.Join(", ", key.Select(c => Web.Parameter(c) + ": " + Web.TypeScript(c)));
       string keyPath = route + string.Concat(key.Select(c => "/${encodeURIComponent(" + Web.Parameter(c) + ")}")); %>
    <%= Web.ClientProperty(table) %>: {
      list: async (list: <%= entity %>ListOptions = {}): Promise<Paged<<%= entity %>>> =>
        paged(<%= entity %>Schema).parse(await call("GET", "<%= route %>" + query(list))),
<% if (key.Count > 0) { %>
      get: async (<%= keyParameters %>): Promise<<%= entity %> | undefined> => {
        const row = await found(`<%= keyPath %>`);
        return row === undefined ? undefined : <%= entity %>Schema.parse(row);
      },
      create: async (request: Create<%= entity %>Request): Promise<<%= entity %>> =>
        <%= entity %>Schema.parse(await call("POST", "<%= route %>", Create<%= entity %>RequestSchema.parse(request))),
      update: async (<%= keyParameters %>, request: Update<%= entity %>Request): Promise<void> => {
        await call("PUT", `<%= keyPath %>`, Update<%= entity %>RequestSchema.parse(request));
      },
      delete: async (<%= keyParameters %>): Promise<void> => {
        await call("DELETE", `<%= keyPath %>`);
      },
<% } %>
    },
<% } %>
  };
}

/** The client: its calls for each table. */
export type <%= ApiName %>Client = ReturnType<typeof create<%= ApiName %>Client>;
