<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's EF Core configuration: its table, key, columns and relationships." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Data" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Assembly Src="Names.cs" %>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace <%= Namespace %>;

/// <summary>How <%= Names.Entity(Table) %> maps to <%= Table.Name %>.</summary>
public partial class <%= Names.Entity(Table) %>Configuration : IEntityTypeConfiguration<<%= Names.Entity(Table) %>>
{
    public void Configure(EntityTypeBuilder<<%= Names.Entity(Table) %>> entity)
    {
<% if (Names.Schema(Table) != null) { %>
        entity.ToTable("<%= Literal(Table.Name) %>", "<%= Literal(Names.Schema(Table)) %>");
<% } else { %>
        entity.ToTable("<%= Literal(Table.Name) %>");
<% } %>
<% if (Table.HasPrimaryKey) { %>
        entity.HasKey(e => <%= Names.Members("e", Table, Names.KeyColumns(Table)) %>);
<% } else { %>
        entity.HasNoKey();
<% } %>
<% foreach (ColumnSchema column in Names.Columns(Table)) {
       var settings = new System.Collections.Generic.List<string>();
       if (Names.Property(column) != column.Name) settings.Add("HasColumnName(\"" + Literal(column.Name) + "\")");
       if (Names.ColumnType(column) != null) settings.Add("HasColumnType(\"" + Literal(Names.ColumnType(column)) + "\")");
       if (Names.NumberedByTheApplication(column)) settings.Add("ValueGeneratedNever()");
       if (Names.IsRowVersion(column)) settings.Add("IsRowVersion()");
       else if (Names.IsComputed(column)) settings.Add("HasComputedColumnSql()");
       if (settings.Count == 0) continue; %>
        entity.Property(e => e.<%= Names.Property(column) %>).<%= string.Join(".", settings) %>;
<% } %>
<% foreach (TableKeySchema key in Table.ForeignKeys) { if (!Names.Related(key)) continue; %>
        entity.HasOne(d => d.<%= Names.Navigation(key) %>).WithMany(p => p.<%= Names.Inverse(key) %>)
            .HasForeignKey(d => <%= Names.Members("d", Table, key.ForeignKeyMemberColumns) %>)<% if (!Names.RefersToPrimaryKey(key)) { %>
            .HasPrincipalKey(p => <%= Names.Members("p", key.PrimaryKeyTable, key.PrimaryKeyMemberColumns) %>)<% } %>
            .HasConstraintName("<%= Literal(key.Name) %>");
<% } %>

        ConfigurePartial(entity);
    }

    /// <summary>More of the mapping, in a partial class of your own.</summary>
    partial void ConfigurePartial(EntityTypeBuilder<<%= Names.Entity(Table) %>> entity);
}
<script runat="template">
// A name in a C# string literal: a database's names can have quotes and backslashes (Dbl"Quote).
private static string Literal(string text) => text.Replace("\\", "\\\\").Replace("\"", "\\\"");

// The configuration's file, as Entities.cst names it (CustomerConfiguration.cs).
public override string GetFileName() =>
    Table == null ? base.GetFileName() : Names.Entity(Table) + "Configuration.cs";
</script>
