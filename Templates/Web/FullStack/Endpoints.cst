<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's minimal API: its response and request records, and its endpoints (a list to page, sort, search and filter; get, create, update, delete)." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Api" Description="The API's namespace." %>
<%@ Property Name="DataNamespace" Type="System.String" Default="MyApp.Data" Description="The entities' namespace." %>
<%@ Property Name="ContextName" Type="System.String" Default="AppDbContext" Description="The DbContext's class name." %>
<%@ Property Name="ApiName" Type="System.String" Default="App" Description="The class that maps every endpoint ({ApiName}Api): its SaveAsync saves the changes." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Web.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%@ Assembly Src="Ui.cs" %>
<%
    string entity = Names.Entity(Table);
    string set = Names.Set(Table);
    var key = Web.Key(Table);
    // the key as parameters, arguments and a route ("string productId", "productId", "/{productId}")
    string keyParameters = string.Join(", ", key.Select(c => Names.Type(c).TrimEnd('?') + " " + Web.Parameter(c)));
    string keyArguments = string.Join(", ", key.Select(c => Web.Parameter(c)));
    string location = Web.Route(Table) + string.Concat(key.Select(c => "/{entity." + Names.Property(c) + "}"));
    var filters = Web.Filters(Table);
    var searches = Web.Searches(Table);
    var numbers = key.Where(Web.NumberKey).ToList();
    var sorts = Web.Sorts(Table);
    // what ties are broken by: the key's columns (or, without a key, nothing)
    string Then(System.Collections.Generic.IEnumerable<ColumnSchema> columns) => string.Concat(columns.Select(c => ".ThenBy(e => e." + Names.Property(c) + ")"));
    string Order(ColumnSchema column, string direction) =>
        "rows.OrderBy" + direction + "(e => e." + Names.Property(column) + ")" + Then(key.Where(k => k != column));
    // by default: by the key, or the first column it can sort by
    var first = key.Count > 0 ? key[0] : sorts.FirstOrDefault();

    // what a refused save is about (ExplainAsync): its key or a unique index's columns, which another row may have; its
    // references, to rows that may not be there; and the tables that may refer to it (not those its deletes cascade to)
    string Lower(string label) => string.Join(" ", label.Split(' ').Select(w => w.Length > 1 && w.All(c => char.IsUpper(c) || char.IsDigit(c)) ? w : w.ToLowerInvariant()));
    string row = Lower(Ui.Singular(Table));
    var uniques = new System.Collections.Generic.List<System.Collections.Generic.List<ColumnSchema>>();
    if (key.Count > 0 && !key.Any(Web.Generated))
        uniques.Add(key);
    foreach (IndexSchema index in Table.Indexes)
    {
        var columns = index.MemberColumns.Cast<MemberColumnSchema>().Select(c => Table.Columns[c.Name]).ToList();
        if (index.IsUnique && !index.IsPrimaryKey && columns.Count > 0 && columns.All(c => c != null) &&
            !uniques.Any(u => u.Select(c => c.Name).OrderBy(n => n).SequenceEqual(columns.Select(c => c.Name).OrderBy(n => n))))
            uniques.Add(columns);
    }
    var references = Table.ForeignKeys.Cast<TableKeySchema>().Where(Names.Related).ToList();
    var referring = Names.ReferencesTo(Table)
        .Where(k => !(bool.TryParse(System.Convert.ToString(k.ExtendedProperties["CS_CascadeDelete"]?.Value), out bool cascades) && cascades)).ToList();
    string Same(string left, System.Collections.Generic.IEnumerable<ColumnSchema> columns) =>
        string.Join(" && ", columns.Select(c => left + "." + Names.Property(c) + " == entity." + Names.Property(c)));
    string NotNull(System.Collections.Generic.IEnumerable<ColumnSchema> columns) =>
        string.Concat(columns.Where(c => Names.Type(c).EndsWith("?")).Select(c => "entity." + Names.Property(c) + " != null && "));
    string Fields(System.Collections.Generic.IEnumerable<ColumnSchema> columns) => string.Join(", ", columns.Select(c => "\"" + Web.Json(c) + "\""));
    string Labels(System.Collections.Generic.IEnumerable<ColumnSchema> columns) => string.Join(" and ", columns.Select(c => Lower(Ui.Label(c))));
    bool explains = key.Count > 0 && (uniques.Count > 0 || references.Count > 0 || referring.Count > 0);
    string explain = explains ? ", refusal => ExplainAsync(db, entity, refusal)" : "";
%>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
#nullable enable

using System.ComponentModel.DataAnnotations;
using Microsoft.AspNetCore.Http.HttpResults;
using Microsoft.EntityFrameworkCore;
using <%= DataNamespace %>;

namespace <%= Namespace %>;

/// <summary>A row of <%= Table.Name %>, as the API returns it.</summary>
public sealed record <%= entity %>Response
{
<% foreach (ColumnSchema column in Table.Columns) { %>
    public required <%= Names.Type(column) %> <%= Names.Property(column) %> { get; init; }
<% } %>

    public static <%= entity %>Response From(<%= entity %> entity) => new()
    {
<% foreach (ColumnSchema column in Table.Columns) { %>
        <%= Names.Property(column) %> = entity.<%= Names.Property(column) %>,
<% } %>
    };
}

/// <summary>A new row of <%= Table.Name %>.</summary>
public sealed record Create<%= entity %>Request
{
<% foreach (ColumnSchema column in Web.Creates(Table)) { if (Web.Validation(column) != null) { %>
    <%= Web.Validation(column) %>
<% } %>
    public <%= Names.Required(column) %><%= Names.Type(column) %> <%= Names.Property(column) %> { get; init; }
<% } %>

    public <%= entity %> ToEntity() => new()
    {
<% foreach (ColumnSchema column in Table.Columns) { %>
<% if (Web.Creates(Table).Contains(column)) { %>
        <%= Names.Property(column) %> = <%= Names.Property(column) %>,
<% } else if (Names.Required(column) != "") { %>
        <%= Names.Property(column) %> = null!, // the database's
<% } %>
<% } %>
    };
}

/// <summary>Changes to a row of <%= Table.Name %>: everything but its key.</summary>
public sealed record Update<%= entity %>Request
{
<% foreach (ColumnSchema column in Web.Updates(Table)) { if (Web.Validation(column) != null) { %>
    <%= Web.Validation(column) %>
<% } %>
    public <%= Names.Required(column) %><%= Names.Type(column) %> <%= Names.Property(column) %> { get; init; }
<% } %>

    public void ApplyTo(<%= entity %> entity)
    {
<% foreach (ColumnSchema column in Web.Updates(Table)) { %>
        entity.<%= Names.Property(column) %> = <%= Names.Property(column) %>;
<% } %>
    }
}

/// <summary>The endpoints of <%= Table.Name %>, at <%= Web.Route(Table) %>.</summary>
public static class <%= entity %>Endpoints
{
    public static RouteGroupBuilder Map<%= entity %>Endpoints(this IEndpointRouteBuilder routes)
    {
        var group = routes.MapGroup("<%= Web.Route(Table) %>").WithTags("<%= set %>");

        // a page of rows: sorted by a column (its JSON name), searched for text<% if (filters.Count > 0) { %>, and filtered by a key's columns (?<%= Web.Filter(filters[0]) %>=a&<%= Web.Filter(filters[0]) %>=b)<% } %>
        group.MapGet("/", async (<%= ContextName %> db, int page = 1, int pageSize = 50, string? sort = null, bool desc = false, string? search = null<% foreach (ColumnSchema column in filters) { %>, <%= Names.Type(column).TrimEnd('?') %>[]? <%= Web.Filter(column) %> = null<% } %>) =>
        {
            pageSize = Math.Clamp(pageSize, 1, 500);
            page = Math.Max(page, 1);
            IQueryable<<%= entity %>> rows = db.<%= set %>.AsNoTracking();
<% foreach (ColumnSchema column in filters) { string filter = Web.Filter(column); string property = "e." + Names.Property(column); %>
            if (<%= filter %> is { Length: > 0 })
<% if (!column.AllowDBNull) { %>
                rows = rows.Where(e => <%= filter %>.Contains(<%= property %>));
<% } else { %>
                rows = rows.Where(e => <%= property %> != null && <%= filter %>.Contains(<%= property %><%= Web.IsValueType(column) ? ".Value" : "" %>));
<% } %>
<% } %>
<% if (searches.Count > 0 || numbers.Count > 0) { %>
            if (!string.IsNullOrWhiteSpace(search))
            {
                // LIKE '%text%', its wildcards escaped<%= Web.SearchLowers(Table) ? ", in lower case (PostgreSQL's LIKE minds case)" : "" %>
                string pattern = "%" + search.Trim()<%= Web.SearchLowers(Table) ? ".ToLowerInvariant()" : "" %>.Replace("\\", "\\\\").Replace("%", "\\%").Replace("_", "\\_") + "%";
<% if (numbers.Count > 0) { %>
                bool isNumber = long.TryParse(search.Trim(), out long number);
<% } %>
                rows = rows.Where(e =>
<% var terms = searches.Select(c => "EF.Functions.Like(e." + Names.Property(c) + (Web.SearchLowers(Table) ? "!.ToLower()" : "") + ", pattern, \"\\\\\")")
       .Concat(numbers.Select(c => "(isNumber && e." + Names.Property(c) + " == number)")).ToList();
   for (int i = 0; i < terms.Count; i++) { %>
                    <%= terms[i] %><%= i < terms.Count - 1 ? " ||" : ");" %>
<% } %>
            }
<% } %>
            int total = await rows.CountAsync();
<% if (first != null) { %>
            rows = sort switch
            {
<% foreach (ColumnSchema column in sorts) { %>
                "<%= Web.Json(column) %>" => desc ? <%= Order(column, "Descending") %> : <%= Order(column, "") %>,
<% } %>
                _ => desc ? <%= Order(first, "Descending") %> : <%= Order(first, "") %>,
            };
<% } %>
            var items = await rows.Skip((page - 1) * pageSize).Take(pageSize).ToListAsync();
            return TypedResults.Ok(new PagedList<<%= entity %>Response>(items.Select(<%= entity %>Response.From).ToList(), total, page, pageSize));
        }).WithName("List<%= set %>");
<% if (key.Count > 0) { %>

        group.MapGet("/<%= Web.KeyRoute(Table) %>", async Task<Results<Ok<<%= entity %>Response>, NotFound>> (<%= keyParameters %>, <%= ContextName %> db) =>
            await db.<%= set %>.FindAsync(<%= keyArguments %>) is { } entity
                ? TypedResults.Ok(<%= entity %>Response.From(entity))
                : TypedResults.NotFound())
            .WithName("Get<%= entity %>");

        group.MapPost("/", async Task<Results<Created<<%= entity %>Response>, ProblemHttpResult>> (Create<%= entity %>Request request, <%= ContextName %> db, IHostEnvironment environment) =>
        {
            var entity = request.ToEntity();
            db.<%= set %>.Add(entity);
            if (await <%= ApiName %>Api.SaveAsync(db, environment<%= explain %>) is { } problem)
                return problem;
            return TypedResults.Created($"<%= location %>", <%= entity %>Response.From(entity));
        }).WithName("Create<%= entity %>").ProducesProblem(StatusCodes.Status409Conflict);

        group.MapPut("/<%= Web.KeyRoute(Table) %>", async Task<Results<NoContent, NotFound, ProblemHttpResult>> (<%= keyParameters %>, Update<%= entity %>Request request, <%= ContextName %> db, IHostEnvironment environment) =>
        {
            if (await db.<%= set %>.FindAsync(<%= keyArguments %>) is not { } entity)
                return TypedResults.NotFound();
            request.ApplyTo(entity);
            if (await <%= ApiName %>Api.SaveAsync(db, environment<%= explain %>) is { } problem)
                return problem;
            return TypedResults.NoContent();
        }).WithName("Update<%= entity %>").ProducesProblem(StatusCodes.Status409Conflict);

        group.MapDelete("/<%= Web.KeyRoute(Table) %>", async Task<Results<NoContent, NotFound, ProblemHttpResult>> (<%= keyParameters %>, <%= ContextName %> db, IHostEnvironment environment) =>
        {
            if (await db.<%= set %>.FindAsync(<%= keyArguments %>) is not { } entity)
                return TypedResults.NotFound();
            db.<%= set %>.Remove(entity);
            if (await <%= ApiName %>Api.SaveAsync(db, environment<%= explain %>) is { } problem)
                return problem;
            return TypedResults.NoContent();
        }).WithName("Delete<%= entity %>").ProducesProblem(StatusCodes.Status409Conflict);
<% } %>

        return group;
    }
<% if (explains) { %>

    // Why the database refused to save a row, for people (<%= ApiName %>Api.SaveAsync says it): the key another row has, the
    // row a reference is to that isn't there, or the rows that refer to it. Null where none of them is found.
    private static async Task<SaveProblem?> ExplainAsync(<%= ContextName %> db, <%= entity %> entity, SaveRefusal refusal)
    {
        switch (refusal)
        {
            case SaveRefusal.Unique:
<% foreach (var columns in uniques) { bool isKey = columns == key; %>
                if (<%= isKey ? "db.Entry(entity).State == EntityState.Added && " : NotNull(columns) %>await db.<%= set %>.AnyAsync(e => <%= Same("e", columns) %><%= isKey ? "" : " && !(" + Same("e", key) + ")" %>))
                    return SaveProblem.About(<%= Ui.Ts("Another " + row + " already has this " + Labels(columns) + ".") %>, <%= Fields(columns) %>);
<% } %>
                break;
            case SaveRefusal.Reference:
<% foreach (var reference in references) {
       var columns = reference.ForeignKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => Table.Columns[c.Name]).ToList();
       var principal = reference.PrimaryKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => reference.PrimaryKeyTable.Columns[c.Name]).ToList();
       string match = string.Join(" && ", principal.Select((c, i) => "p." + Names.Property(c) + " == entity." + Names.Property(columns[i]))); %>
                if (<%= NotNull(columns) %>!await db.<%= Names.Set(reference.PrimaryKeyTable) %>.AnyAsync(p => <%= match %>))
                    return SaveProblem.About(<%= Ui.Ts("There's no such " + Lower(Ui.Singular(reference.PrimaryKeyTable)) + ".") %>, <%= Fields(columns) %>);
<% } %>
                break;
            case SaveRefusal.Referenced:
<% if (referring.Count > 0) { %>
                var referring = new List<string>();
<% foreach (var reference in referring) {
       var columns = reference.ForeignKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => reference.ForeignKeyTable.Columns[c.Name]).ToList();
       var principal = reference.PrimaryKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => Table.Columns[c.Name]).ToList();
       string match = string.Join(" && ", columns.Select((c, i) => "c." + Names.Property(c) + " == entity." + Names.Property(principal[i]))); %>
                if (await db.<%= Names.Set(reference.ForeignKeyTable) %>.AnyAsync(c => <%= match %>))
                    referring.Add(<%= Ui.Ts(Lower(Ui.Title(reference.ForeignKeyTable))) %>);
<% } %>
                return SaveProblem.Referred(referring.Distinct().ToList(), <%= Ui.Ts(row) %>);
<% } else { %>
                break;
<% } %>
        }
        return null;
    }
<% } %>
}
