{
  "name": "petshop-client",
  "private": true,
  "type": "module",
  "description": "The PetShop API's TypeScript client and its web UI: src/generated is generated (FullStack.csp); src/app (the UI's shell, theme and components) and src/example.ts are yours.",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node src/example.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
