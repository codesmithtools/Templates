<%@ CodeTemplate Language="C#" TargetLanguage="TypeScript" Description="A table in the web UI: its fields (labels, kinds of input, limits, keys), relationships and calls, and its pages (list, detail, new, edit)." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Client" Type="System.String" Default="../../petshop.ts" Description="The generated client, as this file imports it." %>
<%@ Property Name="App" Type="System.String" Default="../../../app" Description="Your app's folder (api.ts, kit/), as this file imports it." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="Tables the UI leaves out (Ui.cst's): relationships to them aren't followed." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Web.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%@ Assembly Src="Ui.cs" %>
<%
    string entity = Names.Entity(Table);
    string variable = Ui.Variable(Table);
    string client = "api." + Web.ClientProperty(Table);
    var key = Web.Key(Table);
    bool keyed = key.Count > 0;
    var filters = Web.Filters(Table);
    var sorts = Web.Sorts(Table);
    System.Func<TableSchema, bool> shown = t => !Ui.Excluded(t, Exclude);
    var references = Table.ForeignKeys.Cast<TableKeySchema>().Where(k => Ui.Follows(k, shown)).ToList();
    var children = Ui.Children(Table).Where(k => Ui.Follows(k, shown) && Web.Key(k.ForeignKeyTable).Count > 0).ToList();
    var recent = Ui.Recent(Table);
    string keyArguments = string.Join(", ", key.Select(c => "key." + Web.Json(c)));
    string types = entity + (keyed ? ", Create" + entity + "Request, Update" + entity + "Request" : ", never, never");
%>
// <auto-generated>Generated by CodeSmith Generator from <%= Table.FullName %>.</auto-generated>
import type { <%= entity %>, <%= entity %>ListOptions<% if (keyed) { %>, Create<%= entity %>Request, Update<%= entity %>Request<% } %> } from "<%= Client %>";
<% if (keyed) { %>
import { Create<%= entity %>RequestSchema, Update<%= entity %>RequestSchema } from "<%= Client %>";
<% } %>
import { api } from "<%= App %>/api.ts";
import { defineTable, ListPage<% if (keyed) { %>, DetailPage, FormPage<% } %>, type PageProps } from "<%= App %>/kit/index.ts";

/** <%= Ui.Title(Table) %> (<%= Table.FullName %>): how the UI shows and edits a row, what it refers to and what refers to it. */
export const <%= variable %> = defineTable<<%= types %>>({
  name: <%= Ui.Ts(Ui.Route(Table)) %>,
  table: <%= Ui.Ts(Table.FullName) %>,
  title: <%= Ui.Ts(Ui.Title(Table)) %>,
  singular: <%= Ui.Ts(Ui.Singular(Table)) %>,
<% if (!string.IsNullOrWhiteSpace(Table.Description)) { %>
  description: <%= Ui.Ts(Table.Description.Trim()) %>,
<% } %>
  icon: <%= Ui.Ts(Ui.Icon(Table)) %>,
  key: <%= Ui.Ts(key.Select(Web.Json)) %>,
  display: <%= Ui.Ts(Ui.Display(Table).Select(Web.Json)) %>,
  columns: <%= Ui.Ts(Ui.Columns(Table).Select(Web.Json)) %>,
  search: <%= (Web.Searches(Table).Count > 0 || key.Any(Web.NumberKey)) ? "true" : "false" %>,
<% if (recent != null) { %>
  recent: <%= Ui.Ts(Web.Json(recent)) %>,
<% } %>
  fields: [
<% foreach (ColumnSchema column in Names.Columns(Table)) {
       var parts = new System.Collections.Generic.List<string>
       {
           "name: " + Ui.Ts(Web.Json(column)),
           "label: " + Ui.Ts(Ui.Label(column)),
           "kind: " + Ui.Ts(Ui.Kind(column)),
           "type: " + Ui.Ts(column.NativeType + (Web.Validation(column) != null ? "(" + column.Size + ")" : Ui.Exact(column) && Web.Native(column) is "decimal" or "numeric" ? "(" + column.Precision + "," + column.Scale + ")" : "")),
       };
       if (column.AllowDBNull) parts.Add("nullable: true");
       if (keyed && Ui.Required(column)) parts.Add("required: true");
       if (column.IsPrimaryKeyMember) parts.Add("key: true");
       if (Web.Generated(column)) parts.Add("generated: true");
       if (Web.Validation(column) != null) parts.Add("maxLength: " + column.Size);
       if (Ui.Kind(column) == "integer") { var range = Ui.Range(column); parts.Add("min: " + range.Min); parts.Add("max: " + range.Max); }
       if (Ui.Exact(column)) { parts.Add("precision: " + column.Precision); parts.Add("scale: " + column.Scale); }
       if (Ui.Default(column) != null) parts.Add("default: " + Ui.Default(column));
       if (Web.Sortable(column)) parts.Add("sortable: true");
       if (filters.Contains(column)) parts.Add("filter: " + Ui.Ts(Web.Filter(column)));
       if (Ui.Mono(column)) parts.Add("mono: true");
       if (Ui.Badge(column)) parts.Add("badge: true");
       if (!string.IsNullOrWhiteSpace(column.Description)) parts.Add("help: " + Ui.Ts(column.Description.Trim()));
%>
    { <%= string.Join(", ", parts) %> },
<% } %>
  ],
  references: [
<% foreach (TableKeySchema reference in references) { %>
    { table: <%= Ui.Ts(Ui.Route(reference.PrimaryKeyTable)) %>, label: <%= Ui.Ts(reference.ForeignKeyMemberColumns.Count == 1 ? Ui.Label(Table.Columns[reference.ForeignKeyMemberColumns[0].Name]) : Ui.Singular(reference.PrimaryKeyTable)) %>, columns: <%= Ui.Pairs(reference) %> },
<% } %>
  ],
  children: [
<% foreach (TableKeySchema child in children) { %>
    { table: <%= Ui.Ts(Ui.Route(child.ForeignKeyTable)) %>, label: <%= Ui.Ts(Ui.ChildLabel(child)) %>, columns: <%= Ui.Pairs(child) %> },
<% } %>
  ],
<% if (keyed) { %>
  create: Create<%= entity %>RequestSchema,
  update: Update<%= entity %>RequestSchema,
<% } %>
  api: {
    list: (options) => <%= client %>.list(options as <%= entity %>ListOptions),
<% if (keyed) { %>
    get: (key) => <%= client %>.get(<%= keyArguments %>),
    create: <%= client %>.create,
    update: (key, request) => <%= client %>.update(<%= keyArguments %>, request),
    delete: (key) => <%= client %>.delete(<%= keyArguments %>),
<% } %>
  },
});

export const <%= entity %>List = (props: PageProps) => <ListPage table={<%= variable %>} {...props} />;
<% if (keyed) { %>
export const <%= entity %>Detail = (props: PageProps) => <DetailPage table={<%= variable %>} {...props} />;
export const <%= entity %>Create = (props: PageProps) => <FormPage table={<%= variable %>} {...props} />;
export const <%= entity %>Edit = (props: PageProps) => <FormPage table={<%= variable %>} edit {...props} />;
<% } %>
