<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="The DbContext: a DbSet per table, and each table's configuration." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Data" %>
<%@ Property Name="ContextName" Type="System.String" Default="AppDbContext" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Assembly Src="Names.cs" %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
#nullable enable

using Microsoft.EntityFrameworkCore;

namespace <%= Namespace %>;

public partial class <%= ContextName %>(DbContextOptions<<%= ContextName %>> options) : DbContext(options)
{
<% foreach (TableSchema table in SourceDatabase.Tables) { %>
    public virtual DbSet<<%= Names.Entity(table) %>> <%= Names.Set(table) %> => Set<<%= Names.Entity(table) %>>();
<% } %>

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
<% foreach (TableSchema table in SourceDatabase.Tables) { %>
        modelBuilder.ApplyConfiguration(new <%= Names.Entity(table) %>Configuration());
<% } %>
        OnModelCreatingPartial(modelBuilder);
    }

    /// <summary>More of the model, in a partial class of your own.</summary>
    partial void OnModelCreatingPartial(ModelBuilder modelBuilder);
}
<script runat="template">
// The context's file, as Entities.cst names it (AppDbContext.cs).
public override string GetFileName() =>
    string.IsNullOrWhiteSpace(ContextName) ? base.GetFileName() : ContextName.Trim() + ".cs";
</script>
