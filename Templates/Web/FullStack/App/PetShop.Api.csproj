<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The API: Program.cs, and what FullStack.csp generates into ../Generated (entities, the DbContext, endpoints). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PetShop.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Generated/**/*.cs" />
    <!-- a copy beside the app, which the API changes, not the sample's -->
    <None Include="../PetShop.db3" Link="PetShop.db3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>
</Project>
