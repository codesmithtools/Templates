<%@ CodeTemplate Language="C#" TargetLanguage="TypeScript" Description="The web UI's tables (UiTable.cst), in the navigation's order, and their pages' routes." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Description="The database." %>
<%@ Property Name="App" Type="System.String" Default="../../app" Description="Your app's folder (kit/), as this file imports it." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="Tables the UI leaves out." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Web.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%@ Assembly Src="Ui.cs" %>
<% var tables = SourceDatabase.Tables.Cast<TableSchema>().Where(t => !Ui.Excluded(t, Exclude)).OrderBy(t => Ui.Title(t), System.StringComparer.OrdinalIgnoreCase).ToList(); %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
import type { Database, Route, Table } from "<%= App %>/kit/index.ts";
<% foreach (TableSchema table in tables) { string entity = Names.Entity(table); %>
import { <%= Ui.Variable(table) %>, <%= entity %>List<% if (Web.Key(table).Count > 0) { %>, <%= entity %>Detail, <%= entity %>Create, <%= entity %>Edit<% } %> } from "./tables/<%= entity %>.tsx";
<% } %>

/** The database the UI was generated from. */
export const database: Database = {
  name: <%= Ui.Ts(SourceDatabase.Name) %>,
  provider: <%= Ui.Ts(Provider()) %>,
};

/** Its tables, in the navigation's order. */
export const tables: Table[] = [<%= string.Join(", ", tables.Select(Ui.Variable)) %>];

/** Their pages: a table's list, and a row's page, new and edit (by its key). */
export const routes: Route[] = [
<% foreach (TableSchema table in tables) {
       string entity = Names.Entity(table);
       string variable = Ui.Variable(table);
       string path = "/" + Ui.Route(table);
       string key = string.Concat(Web.Key(table).Select(c => "/:" + Web.Json(c))); %>
  { path: "<%= path %>", table: <%= variable %>, page: "list", component: <%= entity %>List },
<% if (key.Length > 0) { %>
  { path: "<%= path %>/new", table: <%= variable %>, page: "create", component: <%= entity %>Create },
  { path: "<%= path + key %>", table: <%= variable %>, page: "detail", component: <%= entity %>Detail },
  { path: "<%= path + key %>/edit", table: <%= variable %>, page: "edit", component: <%= entity %>Edit },
<% } %>
<% } %>
];
<script runat="template">
// the database's product, as people name it
private string Provider()
{
    string name = SourceDatabase.Provider?.Name ?? "";
    return name switch
    {
        "SqlSchemaProvider" => "SQL Server",
        "SQLiteSchemaProvider" => "SQLite",
        "PostgreSQLSchemaProvider" => "PostgreSQL",
        "MySQLSchemaProvider" => "MySQL",
        "OracleSchemaProvider" => "Oracle",
        _ => name.Replace("SchemaProvider", ""),
    };
}
</script>
