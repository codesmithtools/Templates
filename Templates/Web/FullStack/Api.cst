<%@ CodeTemplate Language="C#" TargetLanguage="Text" Description="An ASP.NET Core minimal API for a database's tables: a file of endpoints per table (Endpoints.cst), and one that maps them all." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Category="Source" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Api" Category="Output" Description="The API's namespace." %>
<%@ Property Name="DataNamespace" Type="System.String" Default="MyApp.Data" Category="Output" Description="The entities' namespace (Entities.cst's Namespace)." %>
<%@ Property Name="ContextName" Type="System.String" Default="AppDbContext" Category="Output" Description="The DbContext's class name (Entities.cst's ContextName)." %>
<%@ Property Name="ApiName" Type="System.String" Default="App" Category="Output" Description="Names the method that maps every endpoint: Map{ApiName}Api." %>
<%@ Property Name="OutputDirectory" Type="System.String" Default="Generated/Api" Category="Output" Description="Where the files go, relative to the project." %>
<%@ Register Name="EndpointsTemplate" Template="Endpoints.cst" MergeProperties="False" %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.IO" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Web.cs" %>
<%-- The master: Endpoints.cst for each table, and the class that maps them all (with what they share: a page of rows,
how many rows each table has, and saving). A table's endpoints that this run didn't write (a table that's gone) are
removed. --%>
<% Generate(); %>
<script runat="template">
private void Generate()
{
    Directory.CreateDirectory(OutputDirectory);
    var written = new HashSet<string>();
    var maps = new System.Text.StringBuilder();
    var counts = new System.Text.StringBuilder();
    foreach (TableSchema table in SourceDatabase.Tables)
    {
        var endpoints = Create<EndpointsTemplate>();
        endpoints.Table = table;
        endpoints.Namespace = Namespace;
        endpoints.DataNamespace = DataNamespace;
        endpoints.ContextName = ContextName;
        endpoints.ApiName = ApiName;
        string file = Path.Combine(OutputDirectory, Names.Entity(table) + "Endpoints.cs");
        endpoints.RenderToFile(file, true);
        written.Add(Path.GetFullPath(file));
        Response.WriteLine(file);
        maps.Append("        routes.Map" + Names.Entity(table) + "Endpoints();\n");
        counts.Append("                new(\"" + Web.Route(table).Substring("/api/".Length) + "\", await db." + Names.Set(table) + ".CountAsync()),\n");
    }
    string api = Path.Combine(OutputDirectory, ApiName + "Api.cs");
    WriteOutput(api,
        "// <auto-generated>Generated by CodeSmith Generator from " + SourceDatabase.Name + ".</auto-generated>\n" +
        "#nullable enable\n\n" +
        "using System.Data.Common;\n" +
        "using Microsoft.AspNetCore.Http.HttpResults;\n" +
        "using Microsoft.AspNetCore.Mvc;\n" +
        "using Microsoft.EntityFrameworkCore;\n" +
        "using " + DataNamespace + ";\n\n" +
        "namespace " + Namespace + ";\n\n" +
        "public static class " + ApiName + "Api\n{\n" +
        "    /// <summary>Every table's endpoints, and how many rows each has (GET /api).</summary>\n" +
        "    public static IEndpointRouteBuilder Map" + ApiName + "Api(this IEndpointRouteBuilder routes)\n    {\n" +
        maps +
        "        routes.MapGet(\"/api\", async (" + ContextName + " db) =>\n" +
        "            TypedResults.Ok(new List<" + ApiName + "RowCount>\n" +
        "            {\n" +
        counts +
        "            }))\n" +
        "            .WithName(\"CountRows\").WithTags(\"" + ApiName + "\");\n" +
        "        return routes;\n    }\n\n" +
        "    /// <summary>\n" +
        "    /// Saves the changes, or says why the database refused them: 409 Conflict, with a message for people (Another\n" +
        "    /// item already has this name; Line items refer to this item) and the fields it's about, which a table's\n" +
        "    /// endpoints explain where they can. The database's own message is there only in Development: it can name\n" +
        "    /// tables, columns and values.\n" +
        "    /// </summary>\n" +
        "    public static async Task<ProblemHttpResult?> SaveAsync(DbContext db, IHostEnvironment environment, Func<SaveRefusal, Task<SaveProblem?>>? explain = null)\n    {\n" +
        "        try\n        {\n            await db.SaveChangesAsync();\n            return null;\n        }\n" +
        "        catch (DbUpdateException e)\n        {\n" +
        "            var refusal = Refusal(e, db);\n" +
        "            SaveProblem? said = null;\n" +
        "            try\n            {\n                said = explain == null ? null : await explain(refusal);\n            }\n" +
        "            catch (Exception other) when (other is DbException or InvalidOperationException)\n            {\n" +
        "                // the generic message, then\n            }\n" +
        "            said ??= SaveProblem.Of(refusal);\n" +
        "            var problem = said.Errors == null ? new ProblemDetails() : new HttpValidationProblemDetails(said.Errors);\n" +
        "            problem.Status = StatusCodes.Status409Conflict;\n" +
        "            problem.Title = \"The database refused the change.\";\n" +
        "            problem.Detail = said.Detail;\n" +
        "            problem.Extensions[\"refusal\"] = refusal.ToString().ToLowerInvariant();\n" +
        "            if (environment.IsDevelopment())\n" +
        "                problem.Extensions[\"database\"] = (e.InnerException ?? e).Message;\n" +
        "            return TypedResults.Problem(problem);\n" +
        "        }\n    }\n\n" +
        "    /// <summary>Why the database refused a save, by each provider's code: PostgreSQL's SQLSTATE, SQL Server's and MySQL's\n" +
        "    /// error numbers, SQLite's extended result code. A reference that fails while a row is deleted is to that row.</summary>\n" +
        "    public static SaveRefusal Refusal(DbUpdateException e, DbContext db)\n    {\n" +
        "        for (Exception? inner = e.InnerException; inner != null; inner = inner.InnerException)\n        {\n" +
        "            if (inner is not DbException error)\n                continue;\n" +
        "            string? state = error.SqlState;\n" +
        "            int number = error.GetType().GetProperty(\"Number\")?.GetValue(error) is int n ? n : 0;\n" +
        "            int sqlite = error.GetType().GetProperty(\"SqliteExtendedErrorCode\")?.GetValue(error) is int s ? s : 0;\n" +
        "            if (state == \"23505\" || number is 2627 or 2601 or 1062 || sqlite is 2067 or 1555)\n" +
        "                return SaveRefusal.Unique;\n" +
        "            // SQL Server's 547 is a CHECK constraint's too\n" +
        "            if (state == \"23503\" || number is 1451 or 1452 || number == 547 && !error.Message.Contains(\"CHECK\") || sqlite == 787)\n" +
        "                return db.ChangeTracker.Entries().Any(entry => entry.State == EntityState.Deleted) ? SaveRefusal.Referenced : SaveRefusal.Reference;\n" +
        "        }\n" +
        "        return SaveRefusal.Other;\n    }\n}\n\n" +
        "/// <summary>Why the database refused a save: a unique key another row has, a reference to a row that isn't there,\n" +
        "/// rows that refer to the one deleted, or something else (a check).</summary>\n" +
        "public enum SaveRefusal { Other, Unique, Reference, Referenced }\n\n" +
        "/// <summary>What a refused save says, for people: a message, and the fields it's about (their JSON names).</summary>\n" +
        "public sealed record SaveProblem(string? Detail, Dictionary<string, string[]>? Errors = null)\n{\n" +
        "    /// <summary>A message about fields (Another item already has this name), shown beside each of them.</summary>\n" +
        "    public static SaveProblem About(string message, params string[] fields) => new(message, fields.ToDictionary(field => field, _ => new[] { message }));\n\n" +
        "    /// <summary>The tables whose rows refer to the one deleted (Line items refer to this item), or null for none.</summary>\n" +
        "    public static SaveProblem? Referred(IReadOnlyList<string> tables, string row)\n    {\n" +
        "        if (tables.Count == 0)\n            return null;\n" +
        "        string list = tables.Count == 1 ? tables[0] : string.Join(\", \", tables.Take(tables.Count - 1)) + \" and \" + tables[^1];\n" +
        "        return new(char.ToUpperInvariant(list[0]) + list.Substring(1) + \" refer to this \" + row + \". Delete or change them first.\");\n    }\n\n" +
        "    /// <summary>What's said where a table's endpoints can't say more.</summary>\n" +
        "    public static SaveProblem Of(SaveRefusal refusal) => refusal switch\n    {\n" +
        "        SaveRefusal.Unique => new(\"Another row already has this key.\"),\n" +
        "        SaveRefusal.Reference => new(\"It refers to a row that isn't there.\"),\n" +
        "        SaveRefusal.Referenced => new(\"Other rows refer to this one. Delete or change them first.\"),\n" +
        "        _ => new(Detail: null),\n    };\n}\n\n" +
        "/// <summary>A page of rows, and how many there are in all.</summary>\n" +
        "public sealed record PagedList<T>(IReadOnlyList<T> Items, int Total, int Page, int PageSize);\n\n" +
        "/// <summary>How many rows a table has: the table as its endpoints name it (line-items).</summary>\n" +
        "public sealed record " + ApiName + "RowCount(string Table, int Rows);\n");
    written.Add(Path.GetFullPath(api));
    Response.WriteLine(api);

    // a table's endpoints that this run didn't write: its table is gone (RemoveOutput: cs check says it's out of date)
    foreach (string file in Directory.GetFiles(OutputDirectory, "*Endpoints.cs"))
        if (!written.Contains(Path.GetFullPath(file)))
            RemoveOutput(file);
}
</script>
