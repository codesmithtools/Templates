<%@ CodeTemplate Language="C#" TargetLanguage="CSS" Description="CSS custom properties for a color palette, in a light theme and a dark one. Edit the palette in Template Properties with the palette editor (palette-editor.js)." %>
<%@ Assembly Src="ColorPalette.cs" %>
<%@ Import Namespace="CodeSmith.Samples" %>
<%@ Property Name="Palette" Type="CodeSmith.Samples.ColorPalette" Category="Palette" Default="background: #ffffff / #1e1e1e; text: #1f2328 / #e6edf3; primary: #0b5cad / #6cb6ff" Description="The colors: a name, its light value and its dark value. As text: name: #light / #dark; ..." %>
<%@ Property Name="Prefix" Type="System.String" Default="color" Category="Output" Description="What the custom properties' names start with: --color-primary." %>
<%@ Property Name="Selector" Type="System.String" Default=":root" Category="Output" Description="Where the custom properties are set: :root for the whole page, or a class such as .card." %>
<%-- The palette's colors as CSS custom properties: the light values by default, the dark ones when the system's theme
is dark, and either one when an element (the html element, say) has data-theme="light" or "dark". --%>
/* Generated by CodeSmith Generator from Palette.cst. Change the palette there or in Palette.csp, not here. */

<%= Selector %>,
[data-theme="light"] {
  color-scheme: light;
<% foreach (PaletteColor color in Palette) { %>
  <%= Name(color) %>: <%= color.Light %>;
<% } %>
}

@media (prefers-color-scheme: dark) {
  <%= Selector %>:not([data-theme="light"]) {
    color-scheme: dark;
<% foreach (PaletteColor color in Palette) { %>
    <%= Name(color) %>: <%= color.Dark %>;
<% } %>
  }
}

[data-theme="dark"] {
  color-scheme: dark;
<% foreach (PaletteColor color in Palette) { %>
  <%= Name(color) %>: <%= color.Dark %>;
<% } %>
}
<script runat="template">
// --color-primary
private string Name(PaletteColor color) => "--" + (string.IsNullOrEmpty(Prefix) ? "" : Prefix + "-") + color.Name;
</script>
