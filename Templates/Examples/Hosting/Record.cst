<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A C# record with a property for each of Properties: a type and a name (string Street, int? Floor)." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Category="Output" Description="The record's namespace." %>
<%@ Property Name="Name" Type="System.String" Default="Item" Category="Record" Description="The record's name." %>
<%@ Property Name="Properties" Type="System.Collections.Generic.List<System.String>" Optional="True" Category="Record" Description="A property each: its type and its name (string Street, int? Floor). One whose type can't be null is required." %>
<%@ Property Name="Summary" Type="System.String" Optional="True" Category="Record" Description="What the record is, for its documentation." %>
<%@ Import Namespace="System.Collections.Generic" %>
// <auto-generated>Generated by CodeSmith Generator from Record.cst.</auto-generated>
#nullable enable

using System;

namespace <%= Namespace %>;

<% if (!String.IsNullOrEmpty(Summary)) { %>
/// <summary><%= Summary %></summary>
<% } %>
public sealed record <%= Name %>
{
<% foreach (string property in Properties ?? new List<string>()) { %>
    public <%= property.Trim().Split(' ')[0].EndsWith("?") ? "" : "required " %><%= property.Trim() %> { get; init; }
<% } %>
}
