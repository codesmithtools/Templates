<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="What every table's data access shares: transactions, and the exceptions the business objects see." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace: these are in {Namespace}.Dal." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
#nullable enable

namespace <%= Namespace %>.Dal;

/// <summary>A save's transaction: a root and its children are saved together, or not at all.</summary>
public interface ITransactions
{
    /// <summary>Starts a transaction, or joins the one already started (it commits when that one does).</summary>
    Task<ITransaction> BeginAsync();
}

/// <summary>A transaction: disposed without <see cref="CommitAsync"/>, it rolls back.</summary>
public interface ITransaction : IAsyncDisposable
{
    Task CommitAsync();
}

/// <summary>A row that isn't there (any more).</summary>
public class DataNotFoundException(string table, params object?[] key)
    : Exception($"{table} has no row {string.Join(", ", key)}.")
{
    public string Table { get; } = table;
    public IReadOnlyList<object?> Key { get; } = key;
}

/// <summary>A row someone else changed since it was read (its rowversion moved on).</summary>
public class ConcurrencyException(string message, Exception? inner = null) : Exception(message, inner);
