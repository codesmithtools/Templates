<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's data access interface: its DTO (a record of its columns) and what the business objects ask of the DAL." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace: the interface is in {Namespace}.Dal." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string dto = Model.Dto(Table);
    var key = Model.Key(Table);
    bool child = model.IsChild(Table);
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Add to them in a file
// of your own: public partial record <%= dto %>, public partial interface <%= Model.DalInterface(Table) %>.
// </auto-generated>
#nullable enable

namespace <%= Namespace %>.Dal;

/// <summary>A row of <%= Table.Name %>, as the DAL reads and writes it.</summary>
public sealed partial record <%= dto %>
{
<% foreach (ColumnSchema column in model.Columns(Table)) { %>
    public <%= Names.Required(column) %><%= Model.DtoType(column) %> <%= Model.Property(column) %> { get; init; }
<% } %>
}

/// <summary><%= Model.Possessive(Table.Name) %> data access.</summary>
public partial interface <%= Model.DalInterface(Table) %>
{
<% if (child) { var columns = model.ParentKey(Table).ForeignKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => Table.Columns[c.Name]).ToList(); %>
    /// <summary>A <%= model.Parent(Table).Name %> row's rows, in key order.</summary>
    Task<List<<%= dto %>>> FetchBy<%= Model.Class(model.Parent(Table)) %>Async(<%= Model.Parameters(columns) %>);
<% } else { %>
    /// <summary>The row with this key, or null.</summary>
    Task<<%= dto %>?> FetchAsync(<%= Model.Parameters(key) %>);

    /// <summary>Every row, in key order.</summary>
    Task<List<<%= dto %>>> FetchAllAsync();
<% foreach (var c in model.ListCriteria(Table)) { %>

    /// <summary>The rows of a <%= c.Key.PrimaryKeyTable.Name %> row (<%= c.Key.Name %>), in key order.</summary>
    Task<List<<%= dto %>>> Fetch<%= c.Name %>Async(<%= Model.Parameters(c.Columns) %>);
<% } %>
<% if (model.HasNameValueList(Table)) { %>

    /// <summary>Each row's <%= key[0].Name %> and <%= model.DisplayColumn(Table).Name %>, in <%= model.DisplayColumn(Table).Name %>'s order.</summary>
    Task<List<KeyValuePair<<%= Model.ParameterType(key[0]) %>, string>>> FetchNameValuesAsync();
<% } %>
<% } %>

    /// <summary>Inserts a row: what the database made of it (its key, if the database numbers it).</summary>
    Task<<%= dto %>> InsertAsync(<%= dto %> data);

    /// <summary>Updates a row (its key's): what the database made of it. DataNotFoundException if it's gone.</summary>
    Task<<%= dto %>> UpdateAsync(<%= dto %> data);

    /// <summary>Deletes a row<%= model.DescendantsOf(Table).Count > 0 ? ", and its " + Model.And(model.DescendantsOf(Table).Select(t => t.Name)) + " rows first" : "" %>.</summary>
    Task DeleteAsync(<%= Model.Parameters(key) %>);
}
