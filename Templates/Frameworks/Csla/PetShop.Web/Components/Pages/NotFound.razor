@page "/not-found"

<PageTitle>Not found · @Site.Name</PageTitle>
<Breadcrumbs Current="Not found" />

<div class="card">
    <div class="empty">
        <span class="art"><Icon Name="search" Size="24" /></span>
        <h1>There's nothing here</h1>
        <p>The address doesn't match a page. Try the sidebar, or <kbd>Ctrl</kbd> <kbd>K</kbd>.</p>
        <div class="actions"><a class="btn btn-primary" href="">Home</a></div>
    </div>
</div>
