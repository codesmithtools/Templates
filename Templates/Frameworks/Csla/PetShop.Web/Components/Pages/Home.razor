@* Home: each root, how many it has, and what the business objects give the pages. *@
@page "/"
@implements IDisposable
@inject Counts Counts
@inject Palette Palette

<PageTitle>@Site.Name</PageTitle>
<Breadcrumbs Current="Home" />

<div class="hero">
    <div>
        <div class="eyebrow"><Icon Name="sparkles" Size="14" /> Generated by CodeSmith Generator from @Site.Database</div>
        <h1 style="margin-top: 6px">@Site.Name</h1>
        <p>A page for each table's CSLA .NET business objects. The rules, the permissions and the children are the objects': the pages ask them.</p>
    </div>
    <button type="button" class="btn" @onclick="() => Palette.Open()"><Icon Name="search" Size="15" /> Go to… <kbd>Ctrl K</kbd></button>
</div>

<div class="tiles">
    @foreach (var root in Site.Roots)
    {
        int? count = Counts[root];
        <a class="card tile" href="@root.Href">
            <div class="tile-top">
                <span class="icon-tile"><Icon Name="@root.Icon" Size="17" /></span>
                <Icon Name="arrow-right" Size="15" Class="muted" />
            </div>
            @if (count is null)
            {
                <span class="skeleton figure loading"></span>
            }
            else
            {
                <span class="figure">@count.Value.ToString("N0")</span>
            }
            <div class="label"><span>@root.Title</span><code>@root.ListType</code></div>
        </a>
    }
</div>

<div class="section-title"><h2>What the business objects give these pages</h2></div>
<div class="features">
    <div class="card feature">
        <span class="icon-tile"><Icon Name="check-circle" Size="16" /></span>
        <div><h3>Rules, as you type</h3><p>Required, lengths, ranges and rules of your own: each field says what's wrong, and Save waits for them.</p></div>
    </div>
    <div class="card feature">
        <span class="icon-tile"><Icon Name="shield" Size="16" /></span>
        <div><h3>Permissions</h3><p>What you may create, change or delete is the objects' authorization rules. Switch users at the top to see.</p></div>
    </div>
    <div class="card feature">
        <span class="icon-tile"><Icon Name="layers" Size="16" /></span>
        <div><h3>Children, saved together</h3><p>A root's rows are edited in place and saved with it in one transaction; Discard undoes it all (n-level undo).</p></div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Counts.Changed += Refresh;

    protected override Task OnInitializedAsync() => Counts.LoadAsync();

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Counts.Changed -= Refresh;
}
