<Project Sdk="Microsoft.NET.Sdk">
  <!-- The business objects: Generated/ is what Csla.csp generates (again whenever it runs), and your partial classes go
       beside it. It knows the DAL's interfaces, not EF Core. Csla.cst wrote this file once: it's yours. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PetShop.Dal/PetShop.Dal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Csla" Version="10.2.0" />
  </ItemGroup>
</Project>
