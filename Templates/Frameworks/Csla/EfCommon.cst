<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="What the EF Core DAL shares: its transactions, its save, and the services that register it all." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace: this is in {Namespace}.Dal.EfCore." %>
<%@ Property Name="ContextName" Type="System.String" Default="AppDbContext" Description="The DbContext's class name." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<% var model = Model.Of(SourceDatabase, Exclude, Children); string services = "Add" + Model.ServicesName(Namespace) + "Dal"; %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>, and again when the schema changes.</auto-generated>
#nullable enable

using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Storage;
using <%= Namespace %>.Dal;
using <%= Namespace %>.Dal.EfCore;

namespace Microsoft.Extensions.DependencyInjection
{
    public static class <%= Model.ServicesName(Namespace) %>DalServiceCollectionExtensions
    {
        /// <summary>
        /// The DAL, with EF Core: <%= ContextName %> (<paramref name="options"/> picks its database: UseSqlServer, UseNpgsql,
        /// UseSqlite, ...), each table's DAL, and the transactions a save runs in. Scoped: CSLA's data portal gives each
        /// call its own scope, so each save has its own context.
        /// </summary>
        public static IServiceCollection <%= services %>(this IServiceCollection services, Action<DbContextOptionsBuilder> options)
        {
            services.AddDbContext<<%= ContextName %>>(options);
            services.AddScoped<ITransactions, Transactions>();
<% foreach (TableSchema table in model.Tables) { %>
            services.AddScoped<<%= Model.DalInterface(table) %>, <%= Model.Dal(table) %>>();
<% } %>
            return services;
        }
    }
}

namespace <%= Namespace %>.Dal.EfCore
{
    /// <summary>A save's transaction, on the context's connection.</summary>
    public sealed class Transactions(<%= ContextName %> db) : ITransactions
    {
        public async Task<ITransaction> BeginAsync() =>
            db.Database.CurrentTransaction is null ? new Transaction(await db.Database.BeginTransactionAsync()) : Joined.Instance;

        private sealed class Transaction(IDbContextTransaction transaction) : ITransaction
        {
            public Task CommitAsync() => transaction.CommitAsync();
            public ValueTask DisposeAsync() => transaction.DisposeAsync();
        }

        // a transaction inside another: the outer one commits, or rolls back
        private sealed class Joined : ITransaction
        {
            public static readonly Joined Instance = new();
            public Task CommitAsync() => Task.CompletedTask;
            public ValueTask DisposeAsync() => ValueTask.CompletedTask;
        }
    }

    internal static class DbContextExtensions
    {
        /// <summary>SaveChangesAsync, with a rowversion that moved on as the DAL's ConcurrencyException.</summary>
        public static async Task SaveAsync(this DbContext db)
        {
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException e)
            {
                throw new ConcurrencyException("The row changed (or went) since it was read.", e);
            }
        }
    }
}
