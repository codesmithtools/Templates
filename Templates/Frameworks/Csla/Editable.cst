<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's editable business object (BusinessBase): a root, or a child its root saves; its properties, the rules its columns give, and its data portal operations." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace: the objects are in {Namespace}.Business, the DAL's interfaces in {Namespace}.Dal." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.Class(Table);
    bool child = model.IsChild(Table);
    var columns = model.Columns(Table);
    var key = Model.Key(Table);
    var children = model.ChildrenOf(Table);
    string dto = Model.Dto(Table);
    string dal = Model.DalInterface(Table);
    // the children's portals, injected where they're created and fetched
    string portals = string.Concat(children.Select(c => ", [Inject] IChildDataPortal<" + Model.ChildList(c) + "> " + Camel(model.ChildListProperty(c))));
    string keyValues = string.Join(", ", key.Select(Model.Read));
    string parent = child ? Model.Class(model.Parent(Table)) : null;
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Customize <%= name %> in
// a file of your own: public partial class <%= name %> { ... } (see the partial methods below).
// </auto-generated>
#nullable enable
<% if (model.Columns(Table).Any(c => Model.NotNull(c) != "") || children.Count > 0) { %>
// GetProperty(...)! for a <%= model.Columns(Table).Any(c => Model.NotNull(c) != "") ? "string" : "child list" %>, which CSLA keeps non-null (as CSLA's own source generator writes it; CSLA0007 doesn't
// know the operator)
#pragma warning disable CSLA0007
<% } %>

using System.ComponentModel.DataAnnotations;
using Csla;
using Csla.Rules;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Business;

/// <summary>
<% if (child) { %>
/// A row of <%= Table.Name %>: an editable child, in its <%= parent %>'s <%= model.ChildListProperty(Table) %> (<%= model.WhyChild(Table) %>). Its
/// <%= parent %> saves it.
<% } else { %>
/// A row of <%= Table.Name %>: an editable root<%= children.Count > 0 ? ", with its " + Model.And(children.Select(c => c.Name)) + " rows" : "" %>. Get one from
/// <c>IDataPortal&lt;<%= name %>&gt;</c>: <c>CreateAsync()</c>, <c>FetchAsync(<%= Model.Arguments(key) %>)</c>; save it with <c>SaveAsync()</c>.
<% } %>
/// </summary>
public partial class <%= name %> : BusinessBase<<%= name %>>
{
<% foreach (ColumnSchema column in columns) { %>
    public static readonly PropertyInfo<<%= Model.Type(column) %>> <%= Model.Info(column) %> = RegisterProperty<<%= Model.Type(column) %>>(nameof(<%= Model.Property(column) %>));
<% if (Model.Generated(column)) { %>
    /// <summary><%= Model.Identity(column) ? "The database numbers it when it's saved." : "The database sets it." %></summary>
<% } else if (model.FromParent(column)) { %>
    /// <summary>Its <%= parent %>'s <%= Model.Property(model.ParentColumn(column)) %>, set when it's saved.</summary>
<% } else if (model.KeySetOnce(column)) { %>
    /// <summary>Part of its key: set it before it's saved.</summary>
<% } %>
    [<%= string.Join(", ", model.Attributes(column)) %>]
    public <%= Model.Type(column) %> <%= Model.Property(column) %>
    {
        get => GetProperty(<%= Model.Info(column) %>)<%= Model.NotNull(column) %>;
<% if (model.Settable(column)) { %>
        set => SetProperty(<%= Model.Info(column) %>, value);
<% } else { %>
        private set => LoadProperty(<%= Model.Info(column) %>, value);
<% } %>
    }

<% } %>
<% foreach (TableSchema c in children) { string list = Model.ChildList(c); string property = model.ChildListProperty(c); %>
    public static readonly PropertyInfo<<%= list %>> <%= property %>Property = RegisterProperty<<%= list %>>(nameof(<%= property %>));
    /// <summary>Its <%= c.Name %> rows.</summary>
    public <%= list %> <%= property %>
    {
        get => GetProperty(<%= property %>Property)!;
        private set => LoadProperty(<%= property %>Property, value);
    }

<% } %>
<% if (key.Any(model.KeySetOnce)) { %>
    /// <summary>Its key can't change once it's saved.</summary>
    public override bool CanWriteProperty(Csla.Core.IPropertyInfo property) =>
        (IsNew || !(<%= string.Join(" || ", key.Where(model.KeySetOnce).Select(c => "property == " + Model.Info(c))) %>)) && base.CanWriteProperty(property);

<% } %>
<% if (children.Count > 0) { %>
    /// <summary>A change in a child list (a row added, removed or changed) checks the list's rules: a rule of yours on
    /// <%= string.Join(" or ", children.Select(c => model.ChildListProperty(c) + "Property")) %>. CSLA doesn't, by itself.</summary>
    protected override void OnChildChanged(Csla.Core.ChildChangedEventArgs e)
    {
<% foreach (TableSchema c in children) { %>
        BusinessRules.CheckRules(<%= model.ChildListProperty(c) %>Property);
<% } %>
        base.OnChildChanged(e);
    }

<% } %>
    protected override void AddBusinessRules()
    {
        base.AddBusinessRules(); // the attributes' rules
        OnAddBusinessRules();
    }

    /// <summary>Your rules: <c>BusinessRules.AddRule(...)</c>.</summary>
    partial void OnAddBusinessRules();

    [ObjectAuthorizationRules]
    public static void AddObjectAuthorizationRules(IAddObjectAuthorizationRulesContext context) => OnAddObjectAuthorizationRules(context);

    /// <summary>Your authorization rules: <c>BusinessRules.AddRule(typeof(<%= name %>), ...)</c>.</summary>
    static partial void OnAddObjectAuthorizationRules(IAddObjectAuthorizationRulesContext context);

    /// <summary>A new object's defaults, after <%= children.Count > 0 ? "its lists are created" : "CSLA's" %>; its rules are checked next.</summary>
    partial void OnCreated();

    /// <summary>After it's loaded from the database<%= children.Count > 0 ? ", with its children" : "" %>.</summary>
    partial void OnFetched(<%= dto %> data);

    /// <summary>Before it's inserted or updated (IsNew says which): set what the database is given (audit columns, totals).</summary>
    partial void OnSaving();

    /// <summary>After it's saved<%= children.Count > 0 ? ", with its children" : "" %>.</summary>
    partial void OnSaved();

<% string create = child ? "CreateChild" : "Create"; %>
    [<%= create %>]
<% if (children.Count > 0) { %>
    private async Task <%= create %>(<%= portals.TrimStart(',', ' ') %>)
    {
<% foreach (TableSchema c in children) { %>
        <%= model.ChildListProperty(c) %> = await <%= Camel(model.ChildListProperty(c)) %>.CreateChildAsync();
<% } %>
<% } else { %>
    private async Task <%= create %>()
    {
<% } %>
        OnCreated();
        await BusinessRules.CheckRulesAsync();
    }

<% if (child) { %>
    [FetchChild]
<% if (children.Count > 0) { %>
    private async Task FetchChild(<%= dto %> data<%= portals %>)
<% } else { %>
    private void FetchChild(<%= dto %> data)
<% } %>
    {
        Load(data);
<% foreach (TableSchema c in children) { %>
        <%= model.ChildListProperty(c) %> = await <%= Camel(model.ChildListProperty(c)) %>.FetchChildAsync(<%= ParentValues(model, c, "data.") %>);
<% } %>
        OnFetched(data);
    }

    [InsertChild]
    private async Task InsertChild(<%= parent %> parent, [Inject] <%= dal %> dal)
    {
<% foreach (ColumnSchema column in columns.Where(model.FromParent)) { %>
        LoadProperty(<%= Model.Info(column) %>, parent.<%= Model.Property(model.ParentColumn(column)) %>);
<% } %>
        OnSaving();
        Load(await dal.InsertAsync(ToDto()));
<% if (children.Count > 0) { %>
        await FieldManager.UpdateChildrenAsync(this);
<% } %>
        OnSaved();
    }

    [UpdateChild]
    private async Task UpdateChild(<%= parent %> parent, [Inject] <%= dal %> dal)
    {
        OnSaving();
        if (IsSelfDirty)
            Load(await dal.UpdateAsync(ToDto()));
<% if (children.Count > 0) { %>
        await FieldManager.UpdateChildrenAsync(this);
<% } %>
        OnSaved();
    }

    [DeleteSelfChild]
    private async Task DeleteSelfChild(<%= parent %> parent, [Inject] <%= dal %> dal) =>
        await dal.DeleteAsync(<%= keyValues %>); // and its children's rows
<% } else { %>
    [Fetch]
    private async Task Fetch(<%= Model.Parameters(key) %>, [Inject] <%= dal %> dal<%= portals %>)
    {
        var data = await dal.FetchAsync(<%= Model.Arguments(key) %>) ?? throw new DataNotFoundException(<%= Model.Literal(Table.Name) %>, <%= Model.Arguments(key) %>);
        Load(data);
<% foreach (TableSchema c in children) { %>
        <%= model.ChildListProperty(c) %> = await <%= Camel(model.ChildListProperty(c)) %>.FetchChildAsync(<%= ParentValues(model, c, "data.") %>);
<% } %>
        OnFetched(data);
    }

    [Insert]
    private async Task Insert([Inject] <%= dal %> dal, [Inject] ITransactions transactions)
    {
        OnSaving();
        await using var transaction = await transactions.BeginAsync();
        Load(await dal.InsertAsync(ToDto()));
<% if (children.Count > 0) { %>
        await FieldManager.UpdateChildrenAsync(this);
<% } %>
        await transaction.CommitAsync();
        OnSaved();
    }

    [Update]
    private async Task Update([Inject] <%= dal %> dal, [Inject] ITransactions transactions)
    {
        OnSaving();
        await using var transaction = await transactions.BeginAsync();
        if (IsSelfDirty)
            Load(await dal.UpdateAsync(ToDto()));
<% if (children.Count > 0) { %>
        await FieldManager.UpdateChildrenAsync(this);
<% } %>
        await transaction.CommitAsync();
        OnSaved();
    }

    [DeleteSelf]
    private async Task DeleteSelf([Inject] <%= dal %> dal, [Inject] ITransactions transactions) =>
        await Delete(<%= keyValues %>, dal, transactions);

    [Delete]
    private async Task Delete(<%= Model.Parameters(key) %>, [Inject] <%= dal %> dal, [Inject] ITransactions transactions)
    {
        await using var transaction = await transactions.BeginAsync();
        await dal.DeleteAsync(<%= Model.Arguments(key) %>); // and its children's rows
        await transaction.CommitAsync();
    }
<% } %>

    private void Load(<%= dto %> data)
    {
<% foreach (ColumnSchema column in columns) { %>
        LoadProperty(<%= Model.Info(column) %>, <%= Model.FromDto(column, "data." + Model.Property(column)) %>);
<% } %>
    }

    private <%= dto %> ToDto() => new()
    {
<% foreach (ColumnSchema column in columns) { %>
        <%= Model.Property(column) %> = <%= Model.ToDto(column, Model.Read(column)) %>,
<% } %>
    };
}
<script runat="template">
// a portal's parameter: lineItems
private static string Camel(string name) => char.ToLowerInvariant(name[0]) + name.Substring(1);

// a child list's fetch arguments: the values of the parent's columns its key refers to, in the key's order
private static string ParentValues(Model model, TableSchema child, string prefix) =>
    string.Join(", ", model.ParentKey(child).PrimaryKeyMemberColumns.Cast<MemberColumnSchema>()
        .Select(c => prefix + Model.Property(model.Parent(child).Columns[c.Name])));
</script>
