<Project Sdk="Microsoft.NET.Sdk">
  <!-- The demo: the business objects, on the EF Core DAL, against a copy of PetShop.db3. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PetShop.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PetShop.Business/PetShop.Business.csproj" />
    <ProjectReference Include="../PetShop.Dal.EfCore/PetShop.Dal.EfCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../PetShop.db3" Link="PetShop.db3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
