<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A table's data access with EF Core: the DAL interface's methods, on the table's entity." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace: this is in {Namespace}.Dal.EfCore, with the entities." %>
<%@ Property Name="ContextName" Type="System.String" Default="AppDbContext" Description="The DbContext's class name." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string entity = Names.Entity(Table);
    string set = Names.Set(Table);
    string dto = Model.Dto(Table);
    string name = Model.Dal(Table);
    var key = Model.Key(Table);
    var included = model.Columns(Table);
    string order = OrderBy(key);
    var rowVersion = included.FirstOrDefault(Names.IsRowVersion);
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Add to it in a file of
// your own: public partial class <%= name %> { ... }.
// </auto-generated>
#nullable enable

using System.Linq.Expressions;
using Microsoft.EntityFrameworkCore;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Dal.EfCore;

/// <summary><%= Model.Possessive(Table.Name) %> data access, with EF Core.</summary>
public partial class <%= name %>(<%= ContextName %> db) : <%= Model.DalInterface(Table) %>
{
    // a row as the business objects have it: EF Core selects just these columns
    private static readonly Expression<Func<<%= entity %>, <%= dto %>>> AsDto = e => new <%= dto %>
    {
<% foreach (ColumnSchema column in included) { %>
        <%= Model.Property(column) %> = e.<%= Names.Property(column) %>,
<% } %>
    };

    private static readonly Func<<%= entity %>, <%= dto %>> ToDto = AsDto.Compile();

    /// <summary>Before a new row's saved: set what the DTO doesn't have (an excluded column).</summary>
    partial void OnInserting(<%= dto %> data, <%= entity %> entity);

    /// <summary>Before a changed row's saved.</summary>
    partial void OnUpdating(<%= dto %> data, <%= entity %> entity);
<% if (model.IsChild(Table)) { var columns = model.ParentKey(Table).ForeignKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => Table.Columns[c.Name]).ToList(); %>

    public async Task<List<<%= dto %>>> FetchBy<%= Model.Class(model.Parent(Table)) %>Async(<%= Model.Parameters(columns) %>) =>
        await db.<%= set %>.AsNoTracking().Where(e => <%= Equal(columns) %>)<%= order %>.Select(AsDto).ToListAsync();
<% } else { %>

    public async Task<<%= dto %>?> FetchAsync(<%= Model.Parameters(key) %>) =>
        await db.<%= set %>.AsNoTracking().Where(e => <%= Equal(key) %>).Select(AsDto).SingleOrDefaultAsync();

    public async Task<List<<%= dto %>>> FetchAllAsync() =>
        await db.<%= set %>.AsNoTracking()<%= order %>.Select(AsDto).ToListAsync();
<% foreach (var c in model.ListCriteria(Table)) { %>

    public async Task<List<<%= dto %>>> Fetch<%= c.Name %>Async(<%= Model.Parameters(c.Columns) %>) =>
        await db.<%= set %>.AsNoTracking().Where(e => <%= Equal(c.Columns) %>)<%= order %>.Select(AsDto).ToListAsync();
<% } %>
<% if (model.HasNameValueList(Table)) { var display = model.DisplayColumn(Table); %>

    public async Task<List<KeyValuePair<<%= Model.ParameterType(key[0]) %>, string>>> FetchNameValuesAsync() =>
        (await db.<%= set %>.AsNoTracking().OrderBy(e => e.<%= Names.Property(display) %>).ThenBy(e => e.<%= Names.Property(key[0]) %>)
            .Select(e => new { Key = e.<%= Names.Property(key[0]) %>, Value = e.<%= Names.Property(display) %> }).ToListAsync())
        .Select(e => new KeyValuePair<<%= Model.ParameterType(key[0]) %>, string>(e.Key, e.Value<%= display.AllowDBNull ? " ?? \"\"" : "" %>)).ToList();
<% } %>
<% } %>

    public async Task<<%= dto %>> InsertAsync(<%= dto %> data)
    {
        var entity = new <%= entity %>
        {
<% foreach (ColumnSchema column in Table.Columns) { %>
<% if (included.Contains(column) && !Model.Generated(column)) { %>
            <%= Names.Property(column) %> = data.<%= Model.Property(column) %>,
<% } else if (Names.Required(column) != "") { %>
            <%= Names.Property(column) %> = default!, // <%= included.Contains(column) ? "the database's" : "excluded: set it in OnInserting" %>
<% } %>
<% } %>
        };
        OnInserting(data, entity);
        db.<%= set %>.Add(entity);
        await db.SaveAsync();
        return ToDto(entity);
    }

    public async Task<<%= dto %>> UpdateAsync(<%= dto %> data)
    {
        var entity = await db.<%= set %>.FindAsync(<%= string.Join(", ", key.Select(c => "data." + Model.Property(c))) %>)
            ?? throw new DataNotFoundException(<%= Model.Literal(Table.Name) %>, <%= string.Join(", ", key.Select(c => "data." + Model.Property(c))) %>);
<% if (rowVersion != null) { %>
        db.Entry(entity).Property(e => e.<%= Names.Property(rowVersion) %>).OriginalValue = data.<%= Model.Property(rowVersion) %>; // as it was read
<% } %>
<% foreach (ColumnSchema column in included.Where(c => !c.IsPrimaryKeyMember && !Model.Generated(c))) { %>
        entity.<%= Names.Property(column) %> = data.<%= Model.Property(column) %>;
<% } %>
        OnUpdating(data, entity);
        await db.SaveAsync();
        return ToDto(entity);
    }

    public async Task DeleteAsync(<%= Model.Parameters(key) %>)
    {
<% var descendants = model.DescendantsOf(Table); descendants.Reverse(); foreach (TableSchema descendant in descendants) { %>
        await db.<%= Names.Set(descendant) %>.Where(e => <%= DescendantOf(model, descendant) %>).ExecuteDeleteAsync();
<% } %>
        await db.<%= set %>.Where(e => <%= Equal(key) %>).ExecuteDeleteAsync();
    }
}
<script runat="template">
// e.A == a && e.B == b, for columns of this table and their parameters
private static string Equal(IEnumerable<ColumnSchema> columns) =>
    string.Join(" && ", columns.Select(c => "e." + Names.Property(c) + " == " + Model.Parameter(c)));

private static string OrderBy(List<ColumnSchema> columns) =>
    string.Concat(columns.Select((c, i) => (i == 0 ? ".OrderBy" : ".ThenBy") + "(e => e." + Names.Property(c) + ")"));

// A descendant's rows of this table's row: up its parents' navigations to this table's child, whose key columns are
// this table's key (e.LineItem.OrderId == orderId).
private string DescendantOf(Model model, TableSchema descendant)
{
    string path = "e.";
    var t = model.Table(descendant);
    while (!Same(model.Parent(t), Table))
    {
        path += Names.Navigation(model.ParentKey(t)) + ".";
        t = model.Parent(t);
    }
    var key = model.ParentKey(t);
    return string.Join(" && ", Enumerable.Range(0, key.ForeignKeyMemberColumns.Count).Select(i =>
        path + Names.Property(t.Columns[key.ForeignKeyMemberColumns[i].Name]) + " == " + Model.Parameter(Table.Columns[key.PrimaryKeyMemberColumns[i].Name])));
}

private static bool Same(TableSchema a, TableSchema b) => a.Owner == b.Owner && a.Name == b.Name;
</script>
