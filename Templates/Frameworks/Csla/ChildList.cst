<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A child table's editable list (BusinessListBase): its parent's rows of it, fetched by the parent's key and saved with it." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The child table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.ChildList(Table);
    string item = Model.Class(Table);
    var key = model.ParentKey(Table);
    var columns = key.ForeignKeyMemberColumns.Cast<MemberColumnSchema>().Select(c => Table.Columns[c.Name]).ToList();
    string by = "By" + Model.Class(model.Parent(Table));
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Customize <%= name %> in
// a file of your own: public partial class <%= name %> { ... }.
// </auto-generated>
#nullable enable

using Csla;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Business;

/// <summary>A <%= Model.Class(model.Parent(Table)) %>'s <%= Table.Name %> rows: add one with <c>AddNewAsync()</c>, remove one with <c>Remove</c>; its <%= Model.Class(model.Parent(Table)) %> saves them.</summary>
public partial class <%= name %> : BusinessListBase<<%= name %>, <%= item %>>
{
    [FetchChild]
    private async Task FetchChild(<%= Model.Parameters(columns) %>, [Inject] <%= Model.DalInterface(Table) %> dal, [Inject] IChildDataPortal<<%= item %>> portal)
    {
        var rows = await dal.Fetch<%= by %>Async(<%= Model.Arguments(columns) %>);
        using (LoadListMode)
        {
            foreach (var row in rows)
                Add(await portal.FetchChildAsync(row));
        }
    }
}
