<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="How many rows a root table has (CommandBase): the database counts them, so nothing is fetched." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%
    string name = Model.CountName(Table);
    string dal = Model.DalInterface(Table);
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Customize <%= name %> in
// a file of your own: public partial class <%= name %> { ... }.
// </auto-generated>
#nullable enable

using Csla;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Business;

/// <summary>
/// How many <%= Table.Name %> rows there are, counted by the database (<%= Model.ListName(Table) %> fetches them all):
/// <c>(await IDataPortal&lt;<%= name %>&gt;.ExecuteAsync()).Count</c>.
/// </summary>
public partial class <%= name %> : CommandBase<<%= name %>>
{
    public static readonly PropertyInfo<int> CountProperty = RegisterProperty<int>(nameof(Count));

    /// <summary>How many rows.</summary>
    public int Count
    {
        get => ReadProperty(CountProperty);
        private set => LoadProperty(CountProperty, value);
    }

    [Execute]
    private async Task Execute([Inject] <%= dal %> dal) => Count = await dal.CountAsync();
}
