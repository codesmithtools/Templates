<%@ CodeTemplate Language="C#" TargetLanguage="Html" Description="A root's list page (Blazor): its read-only list's columns, its filters (a foreign key's name/value list, for a fetch by it) and each row's editor. The shell's ListPage and ListView do the rest." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The root's table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="../Names.cs" %>
<%@ Assembly Src="../Model.cs" %>
<%@ Assembly Src="../NameWords.cs" %>
<%@ Assembly Src="Web.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.Class(Table);
    string info = Model.InfoName(Table);
    string page = Web.ListPage(Table);
    string route = Web.Route(Table);
    var key = Model.Key(Table);
    var columns = Web.ListColumns(model, Table);
    // a filter for each fetch by a foreign key of one column to a table with a name/value list
    var queryable = new[] { "string", "int", "long", "Guid", "bool", "decimal", "double", "float", "DateTime" };
    var filters = model.ListCriteria(Table)
        .Where(c => c.Columns.Count == 1 && Web.LookupOf(model, c.Columns[0]) != null && queryable.Contains(Model.ParameterType(c.Columns[0])))
        .ToList();
    var lookups = columns.Concat(filters.Select(f => f.Columns[0])).Select(c => Web.LookupOf(model, c)).Where(t => t != null).GroupBy(t => t.Name).Select(g => g.First()).ToList();
%>
@* <auto-generated>
   Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes: <%= Model.Possessive(name) %> list. Add to it in a file
   of your own (public partial class <%= page %>: MoreColumns), or replace it with your own <%= page %>.razor
   outside Generated/: then this one isn't generated.
</auto-generated> *@
@page "/<%= route %>"
@inherits ListPage<<%= info %>>

<ListView TItem="<%= info %>" Page="this">
<% if (filters.Count > 0) { %>
    <Filters>
<% foreach (var filter in filters) { var column = filter.Columns[0]; var lookup = Web.LookupOf(model, column); string label = Web.Singular(lookup); %>
        <div class="filter">
            <span><%= label %></span>
            <LookupPicker Items="<%= Web.LookupField(lookup) %>" Value="<%= Model.Property(column) %>" ValueChanged="value => Pick(nameof(<%= Model.Property(column) %>), value)"
                          AllowNone NoneText="Every <%= label.ToLowerInvariant() %>" Placeholder="Every <%= label.ToLowerInvariant() %>" AriaLabel="<%= label %>" />
        </div>
<% } %>
    </Filters>
<% } %>
    <Columns>
<% foreach (ColumnSchema column in columns) { var lookup = Web.LookupOf(model, column); %>
        <Column TItem="<%= info %>" Title="<%= lookup != null && Model.Friendly(column).EndsWith(" ID") ? Web.Singular(lookup) : Model.Friendly(column) %>" Value="row => row.<%= Model.Property(column) %>"<%= Web.ValueKind(model, column) == "Text" ? "" : " Kind=\"ValueKind." + Web.ValueKind(model, column) + "\"" %><%= Web.KindOf(model, column) is Web.Kind.Decimal or Web.Kind.Money && Web.Scale(column) > 0 ? " Scale=\"" + Web.Scale(column) + "\"" : "" %><%= lookup != null ? " Lookup=\"" + Web.LookupField(lookup) + "\"" : "" %> />
<% } %>
    </Columns>
</ListView>

@code {
<% foreach (var filter in filters) { var column = filter.Columns[0]; %>
    [SupplyParameterFromQuery(Name = "<%= Web.Camel(Model.Property(column)) %>")] public <%= Model.ParameterType(column) %>? <%= Model.Property(column) %> { get; set; }
<% } %>
<% foreach (TableSchema lookup in lookups) { %>
    private IReadOnlyDictionary<object, string>? <%= Web.LookupField(lookup) %>;
<% } %>

    public override RootPage Root => Site.<%= Web.SiteProperty(Table) %>;

    protected override Type EditableType => typeof(<%= name %>);
<% if (filters.Count == 1) { %>

    protected override object? Filter => <%= Model.Property(filters[0].Columns[0]) %>;

    protected override string[] FilterNames => ["<%= Web.Camel(Model.Property(filters[0].Columns[0])) %>"];
<% } else if (filters.Count > 1) { %>

    protected override object? Filter => <%= string.Join(" && ", filters.Select(f => Model.Property(f.Columns[0]) + " is null")) %> ? null : (<%= string.Join(", ", filters.Select(f => Model.Property(f.Columns[0]))) %>);

    protected override string[] FilterNames => [<%= string.Join(", ", filters.Select(f => "\"" + Web.Camel(Model.Property(f.Columns[0])) + "\"")) %>];
<% } %>
<% if (lookups.Count > 0) { %>

    protected override async Task LoadLookupsAsync()
    {
<% foreach (TableSchema lookup in lookups) { %>
        <%= Web.LookupField(lookup) %> = Lookup.Of(await Portals.GetPortal<<%= Model.NameValueListName(lookup) %>>().FetchAsync());
<% } %>
    }
<% } %>

    protected override async Task<IEnumerable<<%= info %>>> FetchAsync()
    {
        var portal = Portals.GetPortal<<%= Model.ListName(Table) %>>();
<% foreach (var filter in filters) { var column = filter.Columns[0]; %>
        if (<%= Model.Property(column) %> is <%= Model.ParameterType(column) %> <%= Model.Parameter(column) %>)
            return await portal.FetchAsync(<%= Model.Parameter(column) %>);
<% } %>
        return await portal.FetchAsync();
    }

    public override string RowHref(<%= info %> row) => $"<%= route %>/<%= string.Join("/", key.Select(c => "{Url.Segment(row." + Model.Property(c) + ")}")) %>";
}
