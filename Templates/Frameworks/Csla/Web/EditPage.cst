<%@ CodeTemplate Language="C#" TargetLanguage="Html" Description="A root's editor page (Blazor): its object's fields, in sections, its children's grids, and how it's loaded, deleted and named. The shell's EditPage and Editor do the rest." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The root's table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="../Names.cs" %>
<%@ Assembly Src="../Model.cs" %>
<%@ Assembly Src="../NameWords.cs" %>
<%@ Assembly Src="Web.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.Class(Table);
    string page = Web.EditPage(Table);
    string route = Web.Route(Table);
    var key = Model.Key(Table);
    var children = model.ChildrenOf(Table);
    var lookups = Web.FormColumns(model, Table).Select(c => Web.LookupOf(model, c)).Where(t => t != null).GroupBy(t => t.Name).Select(g => g.First()).ToList();
    var display = model.DisplayColumn(Table);
    bool named = display != null && System.Text.RegularExpressions.Regex.IsMatch(display.Name, "^(name|title|display_?name|description|user_?name|login|label)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
%>
@* <auto-generated>
   Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes: <%= name %>'s editor. Add to it in a
   file of your own (public partial class <%= page %>: Stats, OnLoadedAsync, OnSavedAsync), or replace it with your own
   <%= page %>.razor outside Generated/: then this one isn't generated.
</auto-generated> *@
@page "/<%= route %>/new"
@page "/<%= route %>/<%= Web.RouteTemplate(key) %>"
@inherits EditPage<<%= name %>>

<Editor Page="this">
<% foreach (var section in Web.Sections(model, Table)) { %>
    <FormSection Title="<%= section.Title %>" Icon="<%= section.Icon %>">
<% foreach (ColumnSchema column in section.Columns) { %>
        <%= Web.Field(model, column, "Model", "") %>
<% } %>
    </FormSection>
<% } %>
<% foreach (TableSchema child in children) { string list = model.ChildListProperty(child); %>
    <<%= Web.Grid(child) %> Items="Model.<%= list %>" ListInfo="@Info(() => Model.<%= list %>)" />
<% } %>
</Editor>

@code {
<% foreach (ColumnSchema column in key) { %>
    [Parameter] public <%= Web.RouteParameter(column).Type %> <%= Model.Property(column) %> { get; set; }
<% } %>
<% foreach (TableSchema lookup in lookups) { %>
    private IReadOnlyDictionary<object, string>? <%= Web.LookupField(lookup) %>;
<% } %>

    public override RootPage Root => Site.<%= Web.SiteProperty(Table) %>;

    protected override async Task<<%= name %>> LoadAsync()
    {
<% foreach (TableSchema lookup in lookups) { %>
        <%= Web.LookupField(lookup) %> ??= Lookup.Of(await Portals.GetPortal<<%= Model.NameValueListName(lookup) %>>().FetchAsync());
<% } %>
        var portal = Portals.GetPortal<<%= name %>>();
        return <%= string.Join(" && ", key.Select(c => Model.Property(c) + " is " + Web.RouteParameter(c).Type.TrimEnd('?') + " " + Model.Parameter(c))) %>
            ? await portal.FetchAsync(<%= string.Join(", ", key.Select(c => Web.RouteParameter(c).Cast + Model.Parameter(c))) %>)
            : await portal.CreateAsync();
    }

    protected override Task DeleteAsync(<%= name %> model) => Portals.GetPortal<<%= name %>>().DeleteAsync(<%= string.Join(", ", key.Select(c => "model." + Model.Property(c))) %>);

    protected override string Href(<%= name %> model) => $"<%= route %>/<%= string.Join("/", key.Select(c => "{Url.Segment(model." + Model.Property(c) + ")}")) %>";

<% if (named) { %>
    protected override string Name(<%= name %> model) => string.IsNullOrWhiteSpace(model.<%= Model.Property(display) %>) ? $"<%= Web.Singular(Table) %> <%= KeyText(key) %>" : model.<%= Model.Property(display) %>;
<% } else { %>
    protected override string Name(<%= name %> model) => $"<%= Web.Singular(Table) %> <%= KeyText(key) %>";
<% } %>
<% if (children.Count > 0) { %>

    public override string? DeleteNote => "Its <%= Model.And(children.Select(c => Web.Title(c).ToLowerInvariant())) %> go with it.";
<% } %>
}
<script runat="template">
// "{model.OrderId}", "{model.OrderId} · {model.LineNum}"
private static string KeyText(List<ColumnSchema> key) => string.Join(" · ", key.Select(c => "{model." + Model.Property(c) + "}"));
</script>
