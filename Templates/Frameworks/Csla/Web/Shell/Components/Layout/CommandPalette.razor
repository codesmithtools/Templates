@* Ctrl+K: go to any list, start a new object, switch the theme or the user; ? shows the shortcuts. *@
@implements IDisposable
@inject Palette Palette
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ApplicationContext ApplicationContext
@inject Toasts Toasts

<button type="button" hidden data-shortcut="palette" @onclick="() => Palette.Open()"></button>
<button type="button" hidden data-shortcut="help" @onclick="() => Palette.Open(shortcuts: true)"></button>

@if (Palette.IsOpen && Palette.ShowsShortcuts)
{
    <div class="overlay" @onclick="Palette.Close" @onkeydown="OnKeyDown">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title" @onclick:stopPropagation>
            <div class="dialog-head">
                <span class="icon-tile"><Icon Name="keyboard" Size="18" /></span>
                <div><h2 id="shortcuts-title">Keyboard shortcuts</h2><p>They work on every page that has what they do.</p></div>
            </div>
            <div class="shortcuts">
                <span>Go to anything</span><span><kbd>Ctrl</kbd><kbd>K</kbd></span>
                <span>Save</span><span><kbd>Ctrl</kbd><kbd>S</kbd></span>
                <span>Cancel, close</span><span><kbd>Esc</kbd></span>
                <span>Search the list</span><span><kbd>/</kbd></span>
                <span>New</span><span><kbd>N</kbd></span>
                <span>Move in a list, open a row</span><span><kbd>↑</kbd><kbd>↓</kbd><kbd>Enter</kbd></span>
                <span>These shortcuts</span><span><kbd>?</kbd></span>
            </div>
            <div class="dialog-actions"><button type="button" class="btn" id="shortcuts-close" @onclick="Palette.Close">Close</button></div>
        </div>
    </div>
}
else if (Palette.IsOpen)
{
    var items = Items();
    <div class="overlay" @onclick="Palette.Close">
        <div class="palette" role="dialog" aria-modal="true" aria-label="Go to" @onclick:stopPropagation>
            <div class="palette-input">
                <Icon Name="search" Size="18" />
                <input id="palette-input" type="text" placeholder="Go to a list, start something new…" autocomplete="off" spellcheck="false"
                       role="combobox" aria-expanded="true" aria-controls="palette-list" aria-activedescendant="@(items.Count > 0 ? "palette-" + _active : null)"
                       value="@_query" @oninput="OnInput" @onkeydown="e => OnKeyDown(e, items)" />
                <kbd>Esc</kbd>
            </div>
            <ul class="palette-list" id="palette-list" role="listbox">
                @{ string? group = null; }
                @for (int i = 0; i < items.Count; i++)
                {
                    int index = i;
                    var item = items[i];
                    if (item.Group != group)
                    {
                        group = item.Group;
                        <li class="palette-group" role="presentation">@group</li>
                    }
                    <li id="palette-@index" role="option" aria-selected="@(index == _active ? "true" : "false")" class="palette-item @(index == _active ? "active" : null)"
                        @onclick="() => RunAsync(item)" @onmousemove="() => _active = index">
                        <Icon Name="@item.Icon" Size="16" />
                        <span class="grow">@item.Title</span>
                        @if (item.Hint is not null)
                        {
                            <small>@item.Hint</small>
                        }
                    </li>
                }
                @if (items.Count == 0)
                {
                    <li class="listbox empty" style="position: static; box-shadow: none; border: 0">Nothing matches “@_query”</li>
                }
            </ul>
            <div class="palette-foot">
                <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
                <span><kbd>Enter</kbd> go</span>
                <span><kbd>Esc</kbd> close</span>
            </div>
        </div>
    </div>
}

@code {
    private sealed record Item(string Group, string Title, string Icon, string? Hint, Func<Task> Run);

    private string _query = "";
    private int _active;
    private bool _wasOpen;

    protected override void OnInitialized() => Palette.Changed += Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Palette.IsOpen && !_wasOpen)
            await JS.InvokeVoidAsync("ui.focus", Palette.ShowsShortcuts ? "#shortcuts-close" : "#palette-input");
        if (!Palette.IsOpen && _wasOpen)
            (_query, _active) = ("", 0);
        _wasOpen = Palette.IsOpen;
    }

    private List<Item> Items()
    {
        var items = new List<Item> { new("Go to", "Home", "home", null, () => Go("")) };
        foreach (var root in Site.Roots)
            items.Add(new("Go to", root.Title, root.Icon, root.ListType, () => Go(root.Href)));
        foreach (var root in Site.Roots)
            items.Add(new("Create", "New " + root.Singular.ToLowerInvariant(), "plus", null, () => Go(root.NewHref)));
        items.Add(new("Theme", "Light theme", "sun", null, () => Theme("light")));
        items.Add(new("Theme", "Dark theme", "moon", null, () => Theme("dark")));
        items.Add(new("Theme", "The system's theme", "monitor", null, () => Theme("system")));
        foreach (var user in DemoUsers.All)
            items.Add(new("Sign in as", user.Name, "user", user.Role + " role", () => SignIn(user)));
        items.Add(new("Help", "Keyboard shortcuts", "keyboard", "?", () => { Palette.Open(shortcuts: true); return Task.CompletedTask; }));

        string[] words = _query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var matching = items.Where(i => words.All(w => (i.Group + " " + i.Title + " " + i.Hint).Contains(w, StringComparison.CurrentCultureIgnoreCase))).ToList();
        if (_active >= matching.Count)
            _active = Math.Max(0, matching.Count - 1);
        return matching;
    }

    private Task Go(string href)
    {
        Palette.Close();
        Navigation.NavigateTo(href);
        return Task.CompletedTask;
    }

    private async Task Theme(string theme)
    {
        Palette.Close();
        await JS.InvokeVoidAsync("ui.theme", theme);
    }

    private async Task SignIn(DemoUser user)
    {
        Palette.Close();
        await JS.InvokeVoidAsync("ui.setCookie", DemoUsers.Cookie, user.Name);
        ApplicationContext.User = user.Principal;
        Toasts.Info("Signed in as " + user.Name, user.Description);
    }

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _active = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e, List<Item> items)
    {
        if (e.Key == "Escape")
            Palette.Close();
        else if (e.Key == "ArrowDown" && items.Count > 0)
            _active = (_active + 1) % items.Count;
        else if (e.Key == "ArrowUp" && items.Count > 0)
            _active = _active <= 0 ? items.Count - 1 : _active - 1;
        else if (e.Key == "Enter" && _active < items.Count)
            await RunAsync(items[_active]);
        if (e.Key is "ArrowDown" or "ArrowUp")
            await JS.InvokeVoidAsync("ui.scrollIntoView", "#palette-" + _active);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Palette.Close();
    }

    private async Task RunAsync(Item item) => await item.Run();

    public void Dispose() => Palette.Changed -= Refresh;
}
