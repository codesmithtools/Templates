<%@ CodeTemplate Language="C#" TargetLanguage="Html" Description="A child list's grid (Blazor): its rows edited in place, a row's details when there are more columns than fit (and its own children), and a new row's number. The shell's ChildGrid and GridCard do the rest." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The child's table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="../Names.cs" %>
<%@ Assembly Src="../Model.cs" %>
<%@ Assembly Src="Web.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string item = Model.Class(Table);
    string list = Model.ChildList(Table);
    string grid = Web.Grid(Table);
    var columns = Web.FormColumns(model, Table);
    var children = model.ChildrenOf(Table);
    // the columns that fit in a row: all of them, up to six; past that, the key and four more, and the rest in the details
    int fit = columns.Count <= 6 ? columns.Count : Math.Max(5, columns.Count(c => c.IsPrimaryKeyMember) + 3);
    var inline = columns.Take(fit).ToList();
    var detail = columns.Skip(fit).ToList();
    var lookups = columns.Select(c => Web.LookupOf(model, c)).Where(t => t != null).GroupBy(t => t.Name).Select(g => g.First()).ToList();
    var numbered = Model.Key(Table).Where(c => model.KeySetOnce(c) && new[] { "int", "long", "short" }.Contains(Model.ParameterType(c))).ToList();
%>
@* <auto-generated>
   Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes: <%= Model.Possessive(Model.Class(model.Parent(Table))) %> <%= list %>, edited in
   place. Add to it in a file of your own (public partial class <%= grid %>: Columns, Totals, OnRowAdded), or replace it
   with your own <%= grid %>.razor outside Generated/: then this one isn't generated.
</auto-generated> *@
@inherits ChildGrid<<%= list %>, <%= item %>>

<GridCard TItem="<%= item %>" Grid="this" Columns="<%= inline.Count %>">
    <Head>
<% foreach (ColumnSchema column in inline) { %>
        <th<%= CellClass(model, column) %> scope="col"><%= Model.Friendly(column) %></th>
<% } %>
    </Head>
    <Row Context="row">
<% foreach (ColumnSchema column in inline) { %>
        <td<%= CellClass(model, column) %>><%= Web.Field(model, column, "row", "row", compact: true) %></td>
<% } %>
    </Row>
<% if (detail.Count > 0 || children.Count > 0) { %>
    <Detail Context="row">
<% if (detail.Count > 0) { %>
        <div class="fields">
<% foreach (ColumnSchema column in detail) { %>
            <%= Web.Field(model, column, "row", "row") %>
<% } %>
        </div>
<% } %>
<% foreach (TableSchema child in children) { string property = model.ChildListProperty(child); %>
        <<%= Web.Grid(child) %> Items="row.<%= property %>" ListInfo="@Info(() => row.<%= property %>, row)" />
<% } %>
    </Detail>
<% } %>
</GridCard>

@code {
<% foreach (TableSchema lookup in lookups) { %>
    private IReadOnlyDictionary<object, string>? <%= Web.LookupField(lookup) %>;
<% } %>
    public override string Title => "<%= Web.Title(Table) %>";
    public override string Singular => "<%= Web.Singular(Table).ToLowerInvariant() %>";
    public override string Icon => "<%= Web.Icon(Table) %>";
<% if (detail.Count > 0 || children.Count > 0) { %>
    public override bool HasDetail => true;
<% } %>
<% if (lookups.Count > 0) { %>

    protected override async Task OnInitializedAsync()
    {
<% foreach (TableSchema lookup in lookups) { %>
        <%= Web.LookupField(lookup) %> = Lookup.Of(await Portals.GetPortal<<%= Model.NameValueListName(lookup) %>>().FetchAsync());
<% } %>
    }
<% } %>

    /// <summary>A new row<%= numbered.Count > 0 ? ", numbered after the others" : "" %>, with your defaults (OnRowAdded).</summary>
    protected override async Task<<%= item %>> AddRowAsync()
    {
        var row = await Items.AddNewAsync();
<% foreach (ColumnSchema column in numbered) { %>
        row.<%= Model.Property(column) %> = Next(r => r.<%= Model.Property(column) %>);
<% } %>
        OnRowAdded(row);
        return row;
    }

    /// <summary>A new row's defaults, of yours.</summary>
    partial void OnRowAdded(<%= item %> row);
}
<script runat="template">
// a key's column is narrow, a number's right-aligned, a date's and a yes or no's sized to them
private static string CellClass(Model model, ColumnSchema column)
{
    var kind = Web.KindOf(model, column);
    string css = column.IsPrimaryKeyMember ? "key" :
        kind is Web.Kind.Integer or Web.Kind.Decimal or Web.Kind.Money ? "num" :
        kind is Web.Kind.Date or Web.Kind.DateTime or Web.Kind.Time ? "date" :
        kind == Web.Kind.Bool ? "bool" : "";
    return css.Length == 0 ? "" : " class=\"" + css + "\"";
}
</script>