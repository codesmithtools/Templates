<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="The web app's roots (Site.g.cs): each one's pages, title and icon and how to count its rows, for the sidebar, the home page and the palette; and the namespaces every page uses." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="../Names.cs" %>
<%@ Assembly Src="../Model.cs" %>
<%@ Assembly Src="Web.cs" %>
<%
    var model = Model.Of(SourceDatabase, Exclude, Children);
    // the roots with children first (an order and its lines), then the rest, each in the database's order
    var roots = model.Tables.Where(t => !model.IsChild(t)).OrderBy(t => model.ChildrenOf(t).Count > 0 ? 0 : 1).ToList();
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= SourceDatabase.Name %>, and again when the schema changes: the roots' pages, and the
// namespaces every page and component uses.
// </auto-generated>
global using <%= Namespace %>.Business;
global using <%= Namespace %>.Dal;
global using <%= Namespace %>.Web.Components;
global using <%= Namespace %>.Web.Components.Layout;
global using <%= Namespace %>.Web.Components.Ui;
global using <%= Namespace %>.Web.Pages;
#nullable enable

namespace <%= Namespace %>.Web;

/// <summary>The app: its name, and its roots' pages (their lists and editors).</summary>
public static class Site
{
    public const string Name = <%= Model.Literal(Namespace) %>;
    public const string Database = <%= Model.Literal(SourceDatabase.Name) %>;

<% foreach (TableSchema table in roots) { %>
    public static RootPage <%= Web.SiteProperty(table) %> { get; } = new(<%= Model.Literal(Web.Title(table)) %>, <%= Model.Literal(Web.Singular(table)) %>, <%= Model.Literal(Web.Route(table)) %>, <%= Model.Literal(Web.Icon(table)) %>, "<%= Model.ListName(table) %>",
        async portals => (await portals.GetPortal<<%= Model.ListName(table) %>>().FetchAsync()).Count);

<% } %>
    /// <summary>The sidebar's order.</summary>
    public static IReadOnlyList<RootPage> Roots { get; } = [<%= string.Join(", ", roots.Select(Web.SiteProperty)) %>];
}
