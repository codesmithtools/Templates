<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A root table's read-only list (ReadOnlyListBase): all its rows, or those of a foreign key's value." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.ListName(Table);
    string item = Model.InfoName(Table);
    string dal = Model.DalInterface(Table);
    var criteria = model.ListCriteria(Table);
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Customize <%= name %> in
// a file of your own: public partial class <%= name %> { ... } (another [Fetch] for criteria of your own).
// </auto-generated>
#nullable enable

using Csla;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Business;

/// <summary>
/// <%= Table.Name %> rows, read-only. From <c>IDataPortal&lt;<%= name %>&gt;</c>: <c>FetchAsync()</c> for all of them<%= criteria.Count == 0 ? "." : "," %>
<% for (int i = 0; i < criteria.Count; i++) { %>
/// <c>FetchAsync(<%= Model.Arguments(criteria[i].Columns) %>)</c> for a <%= criteria[i].Key.PrimaryKeyTable.Name %>'s<%= i == criteria.Count - 1 ? "." : "," %>
<% } %>
/// </summary>
public partial class <%= name %> : ReadOnlyListBase<<%= name %>, <%= item %>>
{
    [Fetch]
    private async Task Fetch([Inject] <%= dal %> dal, [Inject] IChildDataPortal<<%= item %>> portal) =>
        await LoadRows(await dal.FetchAllAsync(), portal);
<% foreach (var c in criteria) { %>

    [Fetch]
    private async Task Fetch(<%= Model.Parameters(c.Columns) %>, [Inject] <%= dal %> dal, [Inject] IChildDataPortal<<%= item %>> portal) =>
        await LoadRows(await dal.Fetch<%= c.Name %>Async(<%= Model.Arguments(c.Columns) %>), portal);
<% } %>

    private async Task LoadRows(List<<%= Model.Dto(Table) %>> rows, IChildDataPortal<<%= item %>> portal)
    {
        using (LoadListMode)
        {
            foreach (var row in rows)
                Add(await portal.FetchChildAsync(row));
        }
    }
}
