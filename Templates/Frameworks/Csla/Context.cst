<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="The DbContext: a DbSet per table, and each table's configuration." %>
<%@ Property Name="SourceDatabase" Type="SchemaExplorer.DatabaseSchema" Description="The database." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp.Data" %>
<%@ Property Name="ContextName" Type="System.String" Default="AppDbContext" %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="Tables left out (the master's Exclude): no DbSet." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<% var tables = Names.Tables(SourceDatabase, Exclude); %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceDatabase.Name %>.</auto-generated>
#nullable enable

using Microsoft.EntityFrameworkCore;

namespace <%= Namespace %>;

public partial class <%= ContextName %>(DbContextOptions<<%= ContextName %>> options) : DbContext(options)
{
<% foreach (TableSchema table in tables) { %>
    public virtual DbSet<<%= Names.Entity(table) %>> <%= Names.Set(table) %> => Set<<%= Names.Entity(table) %>>();
<% } %>

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
<% foreach (TableSchema table in tables) { %>
        modelBuilder.ApplyConfiguration(new <%= Names.Configuration(table) %>());
<% } %>
        OnModelCreatingPartial(modelBuilder);
    }

    /// <summary>More of the model, in a partial class of your own.</summary>
    partial void OnModelCreatingPartial(ModelBuilder modelBuilder);
}
<% if (tables.Any(t => Names.Columns(t).Any(Names.StoreTypeString))) { %>

/// <summary>A string the database has a type of its own for (a PostgreSQL enum): its parameters are of that type, as the
/// database takes no text for it (Npgsql would send text).</summary>
internal sealed class StoreTypeStringMapping : Microsoft.EntityFrameworkCore.Storage.StringTypeMapping
{
    public StoreTypeStringMapping(string storeType) : base(storeType, System.Data.DbType.String) { }

    private StoreTypeStringMapping(RelationalTypeMappingParameters parameters) : base(parameters) { }

    protected override Microsoft.EntityFrameworkCore.Storage.RelationalTypeMapping Clone(RelationalTypeMappingParameters parameters) =>
        new StoreTypeStringMapping(parameters);

    protected override void ConfigureParameter(System.Data.Common.DbParameter parameter)
    {
        base.ConfigureParameter(parameter);
        parameter.GetType().GetProperty("DataTypeName")?.SetValue(parameter, StoreType); // NpgsqlParameter's
    }
}
<% } %>
