<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A root table's read-only object (ReadOnlyBase): a row of its read-only list." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%@ Assembly Src="NameWords.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.InfoName(Table);
    string dto = Model.Dto(Table);
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Customize <%= name %> in
// a file of your own: public partial class <%= name %> { ... }.
// </auto-generated>
#nullable enable
<% if (model.Columns(Table).Any(c => Model.NotNull(c) != "")) { %>
// GetProperty(...)! for a string<%= model.Columns(Table).Any(Model.IsList) ? " or a list" : "" %>, which CSLA keeps non-null (as CSLA's own source generator writes it; CSLA0007 doesn't
// know the operator)
#pragma warning disable CSLA0007
<% } %>

using System.ComponentModel.DataAnnotations;
using Csla;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Business;

/// <summary>A row of <%= Table.Name %>, read-only: an item of <%= Model.ListName(Table) %>.</summary>
public partial class <%= name %> : ReadOnlyBase<<%= name %>>
{
<% foreach (ColumnSchema column in model.Columns(Table)) { %>
    public static readonly PropertyInfo<<%= Model.FieldType(column) %>> <%= Model.Info(column) %> = RegisterProperty<<%= Model.FieldType(column) %>>(nameof(<%= Model.Property(column) %>));
    [Display(Name = "<%= Model.Friendly(column) %>")]
    public <%= Model.Type(column) %> <%= Model.Property(column) %>
    {
        get => GetProperty(<%= Model.Info(column) %>)<%= Model.NotNull(column) %>;
        private set => LoadProperty(<%= Model.Info(column) %>, <%= Model.ToField(column, "value") %>);
    }

<% } %>
    /// <summary>After it's loaded: load your own properties from the row.</summary>
    partial void OnFetched(<%= dto %> data);

    [FetchChild]
    private void FetchChild(<%= dto %> data)
    {
<% foreach (ColumnSchema column in model.Columns(Table)) { %>
        <%= Model.Property(column) %> = <%= Model.FromDto(column, "data." + Model.Property(column)) %>;
<% } %>
        OnFetched(data);
    }
}
