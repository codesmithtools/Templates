<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A lookup table's name/value list (NameValueListBase): its keys and the column that names them, for a drop-down." %>
<%@ Property Name="Table" Type="SchemaExplorer.TableSchema" Description="The table." %>
<%@ Property Name="Namespace" Type="System.String" Default="MyApp" Description="The root namespace." %>
<%@ Property Name="Exclude" Type="System.String" Default="" Optional="True" Description="The master's Exclude." %>
<%@ Property Name="Children" Type="System.String" Default="" Optional="True" Description="The master's Children." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
<%@ Import Namespace="System.Linq" %>
<%@ Assembly Src="Names.cs" %>
<%@ Assembly Src="Model.cs" %>
<%
    var model = Model.Of(Table.Database, Exclude, Children);
    string name = Model.NameValueListName(Table);
    var key = Model.Key(Table)[0];
    var display = model.DisplayColumn(Table);
%>
// <auto-generated>
// Generated by CodeSmith Generator from <%= Model.Source(Table) %>, and again when the schema changes. Customize <%= name %> in
// a file of your own: public partial class <%= name %> { ... }.
// </auto-generated>
#nullable enable

using Csla;
using <%= Namespace %>.Dal;

namespace <%= Namespace %>.Business;

/// <summary><%= Model.Possessive(Table.Name) %> <%= key.Name %> and <%= display.Name %>, in <%= display.Name %>'s order: <c>IDataPortal&lt;<%= name %>&gt;.FetchAsync()</c>.</summary>
public partial class <%= name %> : NameValueListBase<<%= Model.ParameterType(key) %>, string>
{
    [Fetch]
    private async Task Fetch([Inject] <%= Model.DalInterface(Table) %> dal)
    {
        var rows = await dal.FetchNameValuesAsync();
        using (LoadListMode)
        {
            foreach (var row in rows)
                Add(new NameValuePair(row.Key, row.Value));
        }
    }
}
