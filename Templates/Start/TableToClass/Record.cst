<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="A C# record for a table: a property for each column, nullable where the column is." %>
<%@ Property Name="SourceTable" Type="SchemaExplorer.TableSchema" Category="Source" Description="The table." %>
<%@ Property Name="TargetNamespace" Type="System.String" Default="MyApp.Data" Category="Output" Description="The record's namespace." %>
<%@ Assembly Name="SchemaExplorer" %>
<%@ Import Namespace="SchemaExplorer" %>
// <auto-generated>Generated by CodeSmith Generator from <%= SourceTable.FullName %>.</auto-generated>
#nullable enable

using System;

namespace <%= TargetNamespace %>;

/// <summary>A row of <%= SourceTable.Name %>.</summary>
public sealed record <%= StringUtil.ToPascalCase(SourceTable.Name) %>
{
<% foreach (ColumnSchema column in SourceTable.Columns) { %>
    public <%= column.AllowDBNull ? "" : "required " %><%= column.GetCSharpTypeName() %> <%= StringUtil.ToPascalCase(column.Name) %> { get; init; }
<% } %>
}
