<%@ CodeTemplate Language="C#" TargetLanguage="C#" Description="Hello world: a class with a property for each name." %>
<%@ Property Name="TargetNamespace" Type="System.String" Default="MyCompany.Generated" Category="Names" Description="The namespace of the class." %>
<%@ Property Name="ClassName" Type="System.String" Default="Hello" Category="Names" Description="The class's name." %>
<%@ Property Name="Fields" Type="System.Collections.Generic.List<System.String>" Optional="True" Category="Members" Description="A property for each name." %>
<%-- Text outside <% %> is output as written; <%= %> writes a value; <% %> runs code. --%>
// Generated by CodeSmith Generator: changes are lost when it generates again.
namespace <%= TargetNamespace %>
{
    public partial class <%= ClassName %>
    {
<% if (Fields != null)
   foreach (string field in Fields) { %>
        public string <%= field %> { get; set; }
<% } %>
    }
}
