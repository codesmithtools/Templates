<?xml version="1.0" encoding="utf-8"?>
<codeSmith xmlns="http://www.codesmithtools.com/schema/csmap.xsd">
  <map caseSensitive="false" returnKeyWhenNotFound="false" description="MySQL data type (DATA_TYPE) to C#, as MySqlConnector reads it. tinyint(1), bit(1), char(36) and unsigned columns share a DATA_TYPE with others: column.GetCSharpTypeName() tells them apart">
