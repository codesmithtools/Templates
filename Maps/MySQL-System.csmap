      <value>System.Decimal</value>
    </item>
    <item>
      <key>date</key>
      <value>System.DateOnly</value>
    </item>
    <item>
      <key>datetime</key>
      <value>System.DateTime</value>
    </item>
    <item>
      <key>timestamp</key>
      <value>System.DateTime</value>
    </item>
    <item>
      <key>time</key>
      <value>System.TimeSpan</value>
    </item>
    <item>
      <key>char</key>
