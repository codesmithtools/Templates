<?xml version="1.0" encoding="utf-8"?>
<codeSmith xmlns="http://www.codesmithtools.com/schema/csmap.xsd">
  <map caseSensitive="false" returnKeyWhenNotFound="false" description="MySQL data type (DATA_TYPE) to .NET type, as MySqlConnector reads it. tinyint(1), bit(1), char(36) and unsigned columns share a DATA_TYPE with others: column.GetClrType(TypeMapping.Modern) tells them apart">
    <item>
      <key>bit</key>
      <value>System.UInt64</value>
    </item>
    <item>
      <key>bool</key>
      <value>System.Boolean</value>
    </item>
    <item>
      <key>boolean</key>
      <value>System.Boolean</value>
    </item>
    <item>
      <key>tinyint</key>
      <value>System.SByte</value>
    </item>
    <item>
      <key>smallint</key>
      <value>System.Int16</value>
    </item>
    <item>
      <key>mediumint</key>
      <value>System.Int32</value>
    </item>
    <item>
      <key>int</key>
      <value>System.Int32</value>
    </item>
    <item>
      <key>integer</key>
      <value>System.Int32</value>
    </item>
    <item>
      <key>year</key>
      <value>System.Int32</value>
    </item>
    <item>
      <key>bigint</key>
      <value>System.Int64</value>
    </item>
    <item>
