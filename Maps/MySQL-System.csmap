      <key>longtext</key>
      <value>System.String</value>
    </item>
    <item>
      <key>enum</key>
      <value>System.String</value>
    </item>
    <item>
      <key>set</key>
      <value>System.String</value>
    </item>
    <item>
      <key>json</key>
      <value>System.String</value>
    </item>
    <item>
      <key>binary</key>
      <value>System.Byte[]</value>
    </item>
    <item>
      <key>varbinary</key>
      <value>System.Byte[]</value>
    </item>
